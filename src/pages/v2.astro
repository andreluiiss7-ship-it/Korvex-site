---
import Capture from '../layouts/Capture.astro';
import { CONSENT_TEXT, QUIZ } from '../../api/_lib/v2-quiz';

const title = 'Korvex 2.0 · Lista de acesso antecipado';
const description =
  'Venda sem medo de MED, com Pix no saldo no mesmo dia e fraudador barrado na rede inteira. A Korvex 2.0 abre primeiro para uma lista fechada, com taxa que não vai estar em tabela.';

// Extrato ilustrativo do hero (valores fictícios).
const tape = [
  { t: '14:02', e: 'Pix aprovado', d: 'Mentoria Escala, disponível hoje', v: '+ R$ 497,00', k: 'in' },
  { t: '14:05', e: 'MED aberto', d: 'Defesa montada: 38 acessos, 92% das aulas', v: 'Defendido', k: 'shield' },
  { t: '14:09', e: 'Compra recusada', d: 'CPF com chargeback em outro checkout Korvex', v: 'Bloqueado', k: 'stop' },
  { t: '14:11', e: 'Saque solicitado', d: 'Pix para a sua conta', v: 'R$ 12.480,00', k: '' },
];

const cuts = [
  ['O dinheiro abre o painel.', 'Faturamento de hoje, vendas pagas e quanto já dá para sacar, na primeira tela. Vendeu de manhã, pede o saque à tarde.'],
  ['MED defendido sem você mexer um dedo.', 'Chegou um MED, o sistema monta a defesa com o que o comprador fez de verdade: acessos, aulas assistidas e aceite dos termos.'],
  ['Fraudador barrado na rede inteira.', 'Deu MED ou chargeback num checkout Korvex, fica bloqueado em todos. Por CPF, e-mail, IP e aparelho.'],
  ['Conteúdo vazado tem nome e CPF.', 'Cada aluno assiste com os próprios dados gravados no vídeo, com limite de aparelhos e link que expira.'],
];

const faqs = [
  ['Custa alguma coisa entrar?', 'Não. A lista é gratuita e não obriga você a migrar nada.'],
  ['Já vendo na Korvex. Preciso entrar?', 'Precisa. É pela lista que você garante a condição de taxa e a prioridade na migração. Se você integra pela API, muda só a URL e as chaves.'],
  ['O que vocês fazem com os meus dados?', 'Usamos só para falar com você sobre a Korvex 2.0. Você pode pedir a exclusão quando quiser.'],
];
---

<Capture title={title} description={description}>
  <a class="skip" href="#lista">Ir para o formulário</a>

  <header class="top">
    <div class="wrap top__in">
      <a href="/" class="brand" aria-label="Korvex, voltar ao site">
        <img src="/v2/korvex-lockup-white.png" alt="Korvex" width="908" height="213" />
        <span class="brand__v">2.0</span>
      </a>
      <a href="#lista" class="top__cta" data-goto-form>Entrar na lista</a>
    </div>
  </header>

  <main>
    <!-- ============ HERO + FORM ============ -->
    <section class="hero" aria-labelledby="h1">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1 id="h1">Venda sem medo de MED.<span class="l2">Pix no saldo no mesmo dia.</span></h1>
          <p class="hero__sub">
            A Korvex 2.0 abre primeiro para uma lista fechada, com uma <strong>taxa que não vai estar em tabela nenhuma</strong>.
          </p>
        </div>

        <div class="funnel-slot">
          <div class="kframe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div id="lista" class="funnel" data-view="form" tabindex="-1">
            <!-- Barra do modo tela cheia (celular, durante o quiz) -->
            <div class="funnel__bar">
              <img src="/v2/korvex-mark-white.png" alt="" width="218" height="213" />
              <div class="funnel__progress" aria-hidden="true"><span></span></div>
              <button type="button" class="icon-btn" data-close aria-label="Fechar e voltar à página">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
              </button>
            </div>

            <!-- Passo 1: contato -->
            <form class="view view--form" id="lead-form" novalidate>
              <div class="view__head">
                <h2 class="funnel__title">Sua vaga na primeira leva</h2>
                <p class="funnel__note">Leva menos de um minuto.</p>
              </div>

              <div class="field">
                <label for="f-name">Nome</label>
                <input id="f-name" name="name" type="text" autocomplete="name" autocapitalize="words" maxlength="80" placeholder="Como você quer ser chamado" aria-describedby="e-name" required />
                <p class="field__err" id="e-name" aria-live="polite"></p>
              </div>
              <div class="field">
                <label for="f-email">E-mail</label>
                <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="120" placeholder="voce@email.com" aria-describedby="e-email" required />
                <p class="field__err" id="e-email" aria-live="polite"></p>
              </div>
              <div class="field">
                <label for="f-phone">WhatsApp</label>
                <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="16" placeholder="(11) 91234-5678" aria-describedby="e-phone" required />
                <p class="field__err" id="e-phone" aria-live="polite"></p>
              </div>

              <!-- honeypot: invisível para gente, irresistível para robô -->
              <div class="hp" aria-hidden="true">
                <label for="f-website">Site</label>
                <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="consent">
                <input id="f-consent" name="consent" type="checkbox" aria-describedby="e-consent" required />
                <label for="f-consent">
                  {CONSENT_TEXT.replace(' Li a Política de Privacidade.', '')} Li a <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>.
                </label>
              </div>
              <p class="field__err field__err--consent" id="e-consent" aria-live="polite"></p>

              <p class="form-alert" role="alert" hidden></p>

              <button class="btn btn--primary btn--block" type="submit">
                <span class="btn__label">Garantir minha vaga</span>
                <svg class="btn__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5.5l4.5 4.5-4.5 4.5" /></svg>
                <span class="spinner" aria-hidden="true"></span>
              </button>
              <p class="funnel__fine">Primeira leva com vagas limitadas. Sem custo e sem compromisso.</p>
            </form>

            <!-- Passo 2: quiz (preenchido pelo script) -->
            <div class="view view--quiz" aria-live="polite"></div>

            <!-- Retomar quiz -->
            <div class="view view--resume">
              <h2 class="funnel__title" tabindex="-1">Você já está na lista<span data-first></span>.</h2>
              <p class="funnel__note">Faltam <span data-left>algumas</span> perguntas para a gente preparar a sua condição.</p>
              <button type="button" class="btn btn--primary btn--block" data-resume>
                Continuar
                <svg class="btn__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5.5l4.5 4.5-4.5 4.5" /></svg>
              </button>
            </div>

            <!-- Passo 3: obrigado -->
            <div class="view view--done">
              <div class="done__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </div>
              <h2 class="funnel__title" tabindex="-1">Pronto<span data-first></span>. Você está na lista.</h2>
              <p class="done__next">
                <strong>Próximo passo:</strong> vamos te chamar no WhatsApp <span class="nowrap" data-phone></span> para apresentar a Korvex 2.0 e a sua condição de taxa.
              </p>
              <p class="funnel__note">Para a mensagem não cair como desconhecida, salve nosso número: <span class="nowrap">(12) 99739-1545</span>.</p>
              <a class="btn btn--primary btn--block done__wa" data-wa href="https://wa.me/5512997391545" target="_blank" rel="noopener">Adiantar a conversa no WhatsApp</a>
              <div class="done__links">
                <button type="button" class="link-btn" data-edit>Corrigir meu WhatsApp</button>
                <button type="button" class="link-btn done__close" data-close>Voltar à página</button>
              </div>
            </div>
          </div>
        </div>

        <figure class="tape" aria-label="Extrato ilustrativo da Korvex 2.0">
            <div role="list">
              {tape.map((r) => (
                <div class="tape__row" role="listitem">
                  <span class="tape__t">{r.t}</span>
                  <span class="tape__e">{r.e}<small>{r.d}</small></span>
                  <span class={`tape__v${r.k ? ` tape__v--${r.k}` : ''}`}>{r.v}</span>
                </div>
              ))}
            </div>
            <figcaption class="tape__cap">Extrato ilustrativo. Valores fictícios.</figcaption>
          </figure>
      </div>
    </section>

    <!-- ============ CORTES ============ -->
    <section class="sec sec--deep" aria-label="O que muda no seu caixa">
      <div class="wrap">
        <div class="cuts">
          {cuts.map(([h, p]) => (
            <div class="cut">
              <h2>{h}</h2>
              <p>{p}</p>
            </div>
          ))}
        </div>
        <p class="more"><b>E ainda:</b> checkout com quiz, lembrete de Pix não pago por e-mail, API e webhooks assinados, UTMify e Pixel da Meta com API de Conversões, equipe com permissão por função.</p>
      </div>
    </section>

    <!-- ============ FECHAMENTO ============ -->
    <section class="sec sec--ink final" aria-labelledby="h-final">
      <div class="wrap final__in">
        <div>
          <h2 id="h-final">A primeira leva tem vagas contadas.</h2>
          <p class="final__lead">Quem entra agora usa antes de todo mundo e recebe a proposta de taxa pelo WhatsApp.</p>
          <a href="#lista" class="btn btn--light" data-goto-form>
            Garantir minha vaga
            <svg class="btn__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5.5l4.5 4.5-4.5 4.5" /></svg>
          </a>
        </div>
        <div class="faq">
          {faqs.map(([q, a]) => (
            <details>
              <summary>
                {q}
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" /></svg>
              </summary>
              <p>
                {a}
                {q.startsWith('O que vocês fazem') && (
                  <Fragment>
                    {' '}Detalhes na <a href="/privacidade">Política de Privacidade</a>.
                  </Fragment>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <img src="/v2/korvex-lockup-white.png" alt="Korvex" width="908" height="213" />
      <nav aria-label="Rodapé">
        <a href="/">korvexgateway.com</a>
        <a href="/privacidade">Política de Privacidade</a>
        <a href="/termos">Termos de Uso</a>
      </nav>
      <p>© 2026 Korvex</p>
    </div>
  </footer>

  <div class="sticky" data-sticky hidden>
    <a href="#lista" class="btn btn--light btn--block" data-goto-form>Garantir minha vaga</a>
  </div>

  <script type="application/json" id="quiz-data" set:html={JSON.stringify(QUIZ)} />
  <script src="../scripts/v2-funnel.ts"></script>
</Capture>

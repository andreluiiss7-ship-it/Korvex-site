---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Produto from '../components/Produto.astro';
import Founder from '../components/Founder.astro';
import Awards from '../components/Awards.astro';
import Payments from '../components/Payments.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { faqs } from '../lib/faq';
import { SITE_URL } from '../lib/site';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Korvex',
    url: SITE_URL,
    logo: `${SITE_URL}/assets/logo-white.png`,
    description: 'Gateway de pagamento pra infoprodutores: Pix D0, zero reserva de segurança, taxa 6,99% + R$ 1,99 travada em contrato.',
    areaServed: 'BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base jsonld={jsonld}>
  <Nav />
  <main>
    <Hero />
    <Problem />
    <Produto />
    <Founder />
    <Awards />
    <Payments />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <StickyCTA />
</Base>

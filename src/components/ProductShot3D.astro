---
// Print real da plataforma (produto demo "Método Escala", sem dado de cliente) montado em 3D.
// Quem gira é o .tilt; o recorte fica no .browser, que é filho. As camadas soltas são filhas
// diretas do .tilt, senão o translateZ delas morre.
import { icon } from '../lib/icons';

interface Props { kind: 'checkout' | 'membros' }
const { kind } = Astro.props;

const shot = kind === 'checkout'
  ? { url: 'pay.korvexgateway.com/ESCALA7', src: 'ck-vitrine', w: [800, 1440], dims: [1440, 900], alt: 'Checkout real da Korvex no tema Vitrine: capa do produto, preço de R$ 97,00 e formulário de Pix' }
  : { url: 'membros.korvexgateway.com/metodo-escala', src: 'membros', w: [760, 1372], dims: [1372, 858], alt: 'Área de membros real da Korvex: capa do curso e as quatro aulas do primeiro módulo' };
---

<div class={`tilt shot shot--${kind}`} data-tilt="4">
  <div class="browser kframe blue in glow-blue">
    <div class="browser-bar">
      <span class="dot bg-[#ff5f57]/80"></span><span class="dot bg-[#febc2e]/80"></span><span class="dot bg-[#28c840]/80"></span>
      <span class="ml-2 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">{shot.url}</span>
      <span class="ml-auto hidden font-mono text-[10px] uppercase tracking-[0.14em] text-chrome-300/50 sm:block">tela real</span>
    </div>
    <img
      src={`/assets/app/${shot.src}-${shot.w[1]}.webp`}
      srcset={`/assets/app/${shot.src}-${shot.w[0]}.webp ${shot.w[0]}w, /assets/app/${shot.src}-${shot.w[1]}.webp ${shot.w[1]}w`}
      sizes="(min-width: 1024px) 620px, 92vw"
      width={shot.dims[0]} height={shot.dims[1]} alt={shot.alt} loading="lazy" decoding="async" data-shot-main={kind}
    />
  </div>

  {kind === 'checkout' && (
    <div class="float3d shot-phone" style="--z:64px" aria-hidden="true">
      <img src="/assets/app/ck-vitrine-mob-585.webp" width="585" height="1200" alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <span class="float3d shot-badge material" style={`--z:${kind === 'checkout' ? 118 : 84}px`} aria-hidden="true">
    <i set:html={icon(kind === 'checkout' ? 'check' : 'cart')} />
    {kind === 'checkout'
      ? <><b>Pix confirmado</b><em>R$ 97,00 · 4 segundos</em></>
      : <><b>Oferta aceita na área</b><em>+R$ 197,00 · Pix</em></>}
  </span>

  {kind === 'membros' && (
    <span class="float3d shot-chip material" style="--z:46px" aria-hidden="true">
      <i set:html={icon('file')} />PDF marcado com nome e CPF
    </span>
  )}
</div>

<style>
  .shot { width: 100%; }
  .shot .browser img { width: 100%; height: auto; }

  .shot-phone { right: -18px; bottom: -34px; width: 27%; max-width: 172px; border-radius: 20px; overflow: hidden; border: 5px solid #0B0F16; outline: 1px solid rgba(255,255,255,.14); background: #0B0F16;
    box-shadow: calc(var(--sx, 0) * -18px) calc(26px + var(--sy, 0) * 14px) 50px -18px rgba(0,0,0,.85); aspect-ratio: 585 / 1130; }
  .shot-phone img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .shot-badge { left: -16px; bottom: 34px; display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center; padding: 10px 14px; border-radius: 14px; background: rgba(11,17,27,.94); border-color: rgba(255,255,255,.16); }
  .shot--membros .shot-badge { left: auto; right: -14px; bottom: 26%; }
  .shot-badge i { grid-row: 1 / 3; display: block; width: 26px; height: 26px; padding: 6px; border-radius: 8px; background: rgba(52,211,153,.16); color: #34D399; }
  .shot-badge b { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #fff; line-height: 1.1; }
  .shot-badge em { font-family: var(--font-mono); font-style: normal; font-size: 10px; letter-spacing: .04em; color: var(--t-2); }

  .shot-chip { left: -12px; top: 22%; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .03em; color: var(--t-1); background: rgba(11,17,27,.94); border-color: rgba(255,255,255,.16); }
  .shot-chip i { display: block; width: 14px; height: 14px; color: var(--gold-2); }

  @media (max-width: 1023px) {
    .shot-phone { right: 6px; bottom: -22px; width: 25%; border-width: 4px; border-radius: 14px; }
    .shot-badge { left: 8px; bottom: -16px; }
    .shot--membros .shot-badge { right: 8px; bottom: -16px; }
    .shot-chip { display: none; }
  }
</style>

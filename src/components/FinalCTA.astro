---
import { icon } from '../lib/icons';
import { WHATSAPP_URL, REGISTER_URL, STATS } from '../lib/site';
import Mosaic from './Mosaic.astro';
---

<section id="contato" class="sec relative">
  <div class="section">
    <div class="reveal relative overflow-hidden rounded-[var(--radius-xl)] border border-[--line-2] bg-[--bg-1] p-8 text-center shadow-depth sm:p-12">
      <div class="pointer-events-none absolute inset-0 z-0">
        <div class="absolute left-1/2 top-0 h-[300px] w-[600px] -translate-x-1/2 rounded-full bg-titan-600/15 blur-[120px]"></div>
        <Mosaic lit={24} seed={23} accent="gold" />
      </div>
      <div class="relative z-10">

      <span class="kicker gold !hidden justify-center lg:!inline-flex">Sua condição em 1h</span>

      <h2 class="h2 mx-auto mt-4 max-w-3xl">
        A Korvex não é pra todo mundo.
        <span class="block font-editorial italic font-normal text-chrome-200/80">É pra quem cansou de pedir o próprio dinheiro.</span>
      </h2>
      <p class="lead mx-auto mt-4 hidden lg:block">
        Mande sua operação. Em 1h um gerente humano responde com a condição do seu volume.
      </p>
      <div class="mt-5 lg:hidden">
        <span class="anchor-num text-gold-gradient">1h</span>
        <span class="anchor-l">resposta de um gerente humano</span>
      </div>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="final-wa" class="btn btn-gold w-full justify-center !px-7 !py-3.5 text-[15px] sm:w-auto">
          <span class="h-5 w-5" set:html={icon('headset')}></span>
          Receber proposta em 1h
        </a>
        <a href={REGISTER_URL} target="_blank" rel="noopener" data-cta="final-register" class="btn btn-ghost w-full justify-center !px-7 !py-3.5 text-[15px] sm:w-auto">
          Abrir conta grátis
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
      </div>

      <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.12em] text-chrome-300/70">
        {STATS.players} operações · {STATS.volume} transacionados · Pix D0 · Zero reserva
      </p>
      </div>
    </div>
  </div>
</section>

---
// Recriação fiel da área de membros real da Korvex (tema moderno).
// Marca e conteúdo são da persona fictícia "Método Escala" — o produtor define
// logo, domínio e cores; aqui a cor primária é o ouro, que é o padrão do tema.
import { icon } from '../lib/icons';

const aulas = [
  { n: '01', t: 'O que é escala e por que a maioria trava antes do primeiro milhão' },
  { n: '02', t: 'Oferta: o combo que levanta o ticket sem subir o custo' },
  { n: '03', t: 'Order bump e upsell em 1 clique dentro do checkout' },
  { n: '04', t: 'Tráfego: escalar sem quebrar o caixa no meio do mês' },
];

const materiais = [
  { name: 'Planilha de metas e projeção.xlsx', tag: 'XLSX', size: '87,7 KB' },
  { name: 'Mapa do funil de upsell.pdf',       tag: 'PDF',  size: '81,7 KB' },
];
---

<div class="relative" data-tilt-zone>
  <div data-tilt="3" class="tilt relative">
    <div class="browser kframe blue in overflow-hidden glow-blue" style="container-type: inline-size;">
    <div class="browser-bar">
      <span class="dot bg-[#ff5f57]/80"></span>
      <span class="dot bg-[#febc2e]/80"></span>
      <span class="dot bg-[#28c840]/80"></span>
      <span class="ml-3 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">alunos.metodoescala.com/club</span>
    </div>

    <div class="ma" role="img" aria-label="Área de membros do cliente com as aulas do módulo 1, exemplo ilustrativo">
      <aside class="ma-side">
        <div class="ma-brand">
          <span class="ma-logo">ME</span>
          <span class="ma-brand-t">MÉTODO ESCALA<small>área de membros</small></span>
        </div>
        <p class="ma-navlbl">Navegação</p>
        <span class="ma-nav on"><span class="ma-nav-i" set:html={icon('home')} />Início</span>
        <span class="ma-nav"><span class="ma-nav-i" set:html={icon('file')} />Materiais</span>
        <div class="ma-user"><span class="ma-avatar" set:html={icon('users')} /><span>Rafa M.</span></div>
      </aside>

      <main class="ma-main">
        <div class="ma-hero">
          <img src="/assets/members/banner-metodo-escala.webp" alt="" width="1280" height="549" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="ma-hero-copy">
            <p class="ma-kicker">Curso Método Escala</p>
            <h4>Área de Membros Exclusiva</h4>
            <p class="ma-sub">Bem-vindo ao início dessa nova jornada.</p>
            <span class="ma-cta"><span class="ma-cta-i" set:html={icon('play')} />Começar agora</span>
          </div>
        </div>

        <p class="ma-modh">Módulo 1: Fundamentos e os primeiros passos</p>

        <div class="ma-aulas">
          {aulas.map((a) => (
            <div class="ma-aula">
              <p class="ma-aula-l">Aula</p>
              <p class="ma-aula-n">{a.n}</p>
              <p class="ma-aula-t">{a.t}</p>
              <span class="ma-aula-c" set:html={icon('chevron')} />
            </div>
          ))}
        </div>

        <div class="ma-files">
          {materiais.map((f) => (
            <div class="ma-file">
              <span class="ma-file-i" set:html={icon('file')} />
              <span class="ma-file-n"><b>{f.name}</b><span><i>{f.tag}</i>{f.size}</span></span>
              <span class="ma-dl" set:html={icon('download')} />
            </div>
          ))}
        </div>
      </main>
    </div>
    </div>

    <div class="float3d material absolute right-2 top-2 rounded-2xl px-3.5 py-2.5 lg:right-[-14px] lg:top-[-14px]" style="--z:40px">
      <div class="flex items-center gap-2.5">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-titan-600/15 text-titan-400" set:html={icon('users')}></span>
        <div>
          <p class="font-display text-sm font-bold leading-none text-white" style="font-feature-settings:'tnum';">1.247</p>
          <p class="mt-0.5 text-[10px] text-chrome-300/70">alunos online agora</p>
        </div>
      </div>
    </div>
    <div class="float3d material absolute -bottom-3 left-2 rounded-2xl px-3.5 py-2.5 lg:bottom-[-10px] lg:left-[-14px]" style="--z:68px">
      <div class="flex items-center gap-2.5">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gold-600/15 text-gold-300" set:html={icon('spark')}></span>
        <div>
          <p class="font-display text-sm font-bold leading-none text-white">+R$ 497</p>
          <p class="mt-0.5 text-[10px] text-gold-300">Upsell vendido na área</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ma {
    --mb: #030719; --ms: #070B1C; --mc: #0D1326; --ln: rgba(255,255,255,.07);
    --mt: #F5F2EB; --mt2: #A8B0C2; --mt3: #6A7388;
    --ac: #D3AF37; --ac2: #E2C386;
    display: grid; grid-template-columns: 12.6em 1fr; min-height: 24em;
    background: var(--mb); overflow: hidden; transform-style: preserve-3d;
    font-size: clamp(8px, 1.72cqw, 12.5px); color: var(--mt2); font-family: var(--font-display);
  }

  /* navegação do aluno */
  .ma-side { display: flex; flex-direction: column; gap: .35em; padding: 1.3em 1em; background: var(--ms); border-right: 1px solid var(--ln); }
  .ma-brand { display: flex; align-items: center; gap: .6em; margin-bottom: 1.5em; }
  .ma-logo { display: grid; place-items: center; width: 2.2em; height: 2.2em; border-radius: .55em; background: var(--ac); color: #1A1405; font-size: 1.05em; font-weight: 800; letter-spacing: -.01em; }
  .ma-brand-t { font-size: .88em; font-weight: 700; letter-spacing: .06em; line-height: 1.1; color: var(--mt); }
  .ma-brand-t small { display: block; font-size: .68em; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--mt3); }
  .ma-navlbl { margin-bottom: .3em; font-family: var(--font-mono); font-size: .66em; letter-spacing: .18em; text-transform: uppercase; color: var(--mt3); }
  .ma-nav { display: flex; align-items: center; gap: .65em; padding: .62em .85em; border-radius: .5em; font-size: .92em; color: var(--mt2); }
  .ma-nav-i { width: 1.15em; height: 1.15em; }
  .ma-nav.on { background: var(--ac); color: #1A1405; font-weight: 700; }
  .ma-user { display: flex; align-items: center; gap: .6em; margin-top: auto; font-size: .88em; color: var(--mt2); }
  .ma-avatar { width: 1.5em; height: 1.5em; color: var(--mt3); }

  .ma-main { display: flex; flex-direction: column; gap: .8em; padding: 1.2em 1.4em 1.3em; min-width: 0; }

  /* capa do curso: imagem à direita, texto à esquerda */
  .ma-hero { position: relative; height: 8.4em; flex: none; border-radius: .8em; overflow: hidden; border: 1px solid var(--ln); background: var(--mc); }
  .ma-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 72% 50%; }
  .ma-hero::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, #030719 0%, rgba(3,7,25,.92) 38%, rgba(3,7,25,.25) 70%, transparent); }
  .ma-hero-copy { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; height: 100%; max-width: 64%; padding: 0 1.5em; }
  .ma-kicker { font-family: var(--font-mono); font-size: .6em; letter-spacing: .2em; text-transform: uppercase; color: var(--mt3); }
  .ma-hero h4 { margin-top: .35em; font-size: 1.65em; font-weight: 700; letter-spacing: -.025em; line-height: 1.05; color: var(--mt); }
  .ma-sub { margin-top: .35em; font-size: .78em; color: var(--mt2); }
  .ma-cta { align-self: flex-start; display: inline-flex; align-items: center; gap: .45em; margin-top: .85em; padding: .5em 1.1em; border-radius: .45em; background: var(--ac); color: #1A1405; font-size: .8em; font-weight: 700; }
  .ma-cta-i { width: 1.1em; height: 1.1em; }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ma-hero img {
      transform: scale(1.07) translate(calc((var(--mx, 50%) - 50%) * -0.05), calc((var(--my, 50%) - 50%) * -0.05));
      transition: transform .5s var(--ease-out);
    }
  }

  .ma-modh { flex: none; font-size: .95em; font-weight: 700; color: var(--mt); }

  /* aulas numeradas, como no tema real */
  .ma-aulas { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7em; }
  .ma-aula { position: relative; display: flex; flex-direction: column; padding: .75em .8em 1.5em; border-radius: .6em; border: 1px solid var(--ln); background: var(--mc); }
  .ma-aula-l { font-family: var(--font-mono); font-size: .6em; letter-spacing: .22em; text-transform: uppercase; text-align: center; color: var(--mt3); }
  .ma-aula-n { margin-top: .1em; padding-bottom: .5em; border-bottom: 1px solid var(--ln); font-size: 2.1em; font-weight: 800; letter-spacing: -.04em; line-height: 1; text-align: center; color: var(--mt); }
  .ma-aula-t { margin-top: .6em; font-size: .68em; line-height: 1.35; color: var(--mt2);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .ma-aula-c { position: absolute; right: .6em; bottom: .55em; width: .85em; height: .85em; color: var(--mt3); }

  /* materiais da aula */
  .ma-files { display: grid; gap: .45em; }
  .ma-file { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .75em; padding: .5em .8em; border-radius: .55em; background: var(--mc); border: 1px solid var(--ln); }
  .ma-file-i { width: 1.9em; height: 1.9em; padding: .42em; border-radius: .45em; background: rgba(211,175,55,.14); color: var(--ac2); }
  .ma-file-n b { display: block; font-size: .8em; font-weight: 600; color: var(--mt); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ma-file-n > span { display: flex; align-items: center; gap: .5em; margin-top: .15em; font-family: var(--font-mono); font-size: .64em; color: var(--mt3); }
  .ma-file-n i { padding: .15em .45em; border-radius: .25em; background: rgba(255,255,255,.07); font-style: normal; letter-spacing: .08em; color: var(--mt2); }
  .ma-dl { width: 1.2em; height: 1.2em; color: var(--mt2); }

  /* a aula em andamento pulsa de leve: a área está sendo usada agora */
  @media (prefers-reduced-motion: no-preference) {
    .ma-aula:nth-child(2) { animation: ma-now 4.5s ease-in-out infinite; }
  }
  @keyframes ma-now {
    0%, 100% { border-color: var(--ln); }
    50%      { border-color: rgba(211,175,55,.45); }
  }

  @media (max-width: 1023px) {
    .ma { grid-template-columns: 1fr; min-height: 0; font-size: 11px; }
    .ma-side { display: none; }
    .ma-main { padding: 1em; gap: .7em; }
    .ma-hero { height: 9.5em; }
    .ma-hero-copy { max-width: 80%; padding: 0 1.2em; }
    .ma-aulas { display: flex; overflow-x: auto; gap: .6em; margin-inline: -1em; padding-inline: 1em; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .ma-aulas::-webkit-scrollbar { display: none; }
    .ma-aula { flex: 0 0 42%; scroll-snap-align: start; }
    .ma-file:nth-child(2) { display: none; }
  }
</style>

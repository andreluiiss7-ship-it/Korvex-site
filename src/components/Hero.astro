---
import { waUrl, REGISTER_URL } from '../lib/site';
import { icon } from '../lib/icons';
import HeroCard3D from './HeroCard3D.astro';

const pills = ['Saque D0 no Pix', 'Saque em cripto', '135+ moedas', 'Upsell one-click'];

const stats = [
  { big: 'R$ 129M+', n: 129,  prefix: 'R$ ', suffix: 'M+', dec: 0, label: 'transacionados' },
  { big: '400+',     n: 400,  prefix: '',    suffix: '+',  dec: 0, label: 'players ativos' },
  { big: '94%',      n: 94,   prefix: '',    suffix: '%',  dec: 0, label: 'aprovação no cartão' },
  { big: '99,9%',    n: 99.9, prefix: '',    suffix: '%',  dec: 1, label: 'uptime no pico' },
];

const flow = [
  { flag: '🇧🇷', v: 'R$ 1.997,00', m: 'Pix · aprovada', d0: true },
  { flag: '🇺🇸', v: 'USD 497,00',  m: 'Cartão · aprovada', d0: false },
  { flag: '🇧🇷', v: 'R$ 6.420,00', m: 'Pix · aprovada', d0: true },
];
---

<section id="topo" class="relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0" style="background: radial-gradient(900px 500px at 70% -10%, rgba(59,130,246,0.10), transparent 60%);"></div>
    <div class="absolute inset-0 bg-grid-faint [background-size:48px_48px] opacity-40 [mask-image:radial-gradient(ellipse_70%_55%_at_40%_30%,#000_20%,transparent_70%)]"></div>
  </div>

  <div class="section">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">

      <!-- manifesto -->
      <div class="text-center lg:text-left">
        <div class="reveal inline-flex items-center gap-2.5 font-mono text-[10px] uppercase sm:text-[11px]" style="letter-spacing:0.22em;color:var(--blue-2);">
          <span class="inline-block h-1.5 w-1.5 flex-none rounded-full bg-[--blue]"></span>
          Korvex · Gateway de alto faturamento
        </div>

        <h1 class="reveal mt-6 font-display font-extrabold leading-[0.96] tracking-[-0.045em] text-white" style="font-size:clamp(2.6rem, 6vw, 4.8rem);">
          A Korvex não joga o jogo deles.
          <span class="block font-editorial italic font-normal text-titan-gradient">Joga o seu.</span>
        </h1>

        <p class="reveal mx-auto mt-6 max-w-xl text-pretty text-[1.05rem] leading-relaxed text-chrome-300/80 sm:text-[1.1rem] lg:mx-0">
          Em cada R$ 1 milhão faturado, o gateway comum leva R$ 120 mil.
          <strong class="text-white">A Korvex devolve <span class="text-gold-gradient font-extrabold">R$ 50 mil</span> por milhão.</strong>
          Saque no dia, gerente em 1h, migração sem parar de vender.
        </p>

        <div class="reveal mt-8 grid gap-3 sm:grid-cols-2">
          <a href={waUrl('Olá! Faturando R$100K+/mês, quero análise da operação na Korvex.')} target="_blank" rel="noopener" class="persona-cta primary group">
            <span class="persona-q">Faturando R$ 100K+ / mês?</span>
            <span class="persona-a">
              Falar com especialista
              <small>· resposta em 1h</small>
              <span class="h-4 w-4" set:html={icon('arrow')}></span>
            </span>
          </a>
          <a href={REGISTER_URL} target="_blank" rel="noopener" class="persona-cta ghost group">
            <span class="persona-q">Começando ou validando?</span>
            <span class="persona-a">
              Criar conta agora
              <span class="h-4 w-4" set:html={icon('arrow')}></span>
            </span>
          </a>
        </div>

        <p class="reveal mt-7 font-mono text-[11px] leading-relaxed tracking-[0.08em] text-chrome-300/60">
          {pills.map((p, i) => (
            <span class="inline-block whitespace-nowrap">
              <span class="text-titan-400/50">[&nbsp;</span><span class="text-chrome-200">{p}</span><span class="text-titan-400/50">&nbsp;]</span>{i < pills.length - 1 && <span class="mx-1.5"> </span>}
            </span>
          ))}
        </p>
      </div>

      <!-- cartão 3D + aprovações ao vivo -->
      <div class="reveal relative mx-auto w-full max-w-[520px] px-4 py-10 lg:max-w-none lg:px-8">
        <span aria-hidden="true" class="pointer-events-none absolute -right-2 -top-6 select-none font-display font-black leading-none" style="font-size:clamp(160px,20vw,280px); color:transparent; -webkit-text-stroke:1px rgba(111,163,224,0.10);">[K</span>

        <HeroCard3D />

        <div class="material absolute -bottom-2 left-0 z-20 hidden w-[230px] rounded-2xl p-3 lg:block">
          <div class="mb-2 flex items-center justify-between">
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-chrome-300/60">Aprovações · ao vivo</span>
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            </span>
          </div>
          <div class="space-y-1.5">
            {flow.map((tx) => (
              <div class="flex items-center gap-2 rounded-lg bg-white/[0.03] px-2.5 py-1.5">
                <span class="text-sm leading-none">{tx.flag}</span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-mono text-[11px] font-semibold text-white" style="font-feature-settings:'tnum';">{tx.v}</p>
                  <p class="truncate text-[9.5px] text-chrome-300/60">{tx.m}</p>
                </div>
                {tx.d0 && <span class="rounded bg-titan-600/20 px-1 py-0.5 font-mono text-[8px] font-bold text-titan-300">D0</span>}
              </div>
            ))}
          </div>
          <div class="mt-2 flex items-center justify-between border-t border-white/[0.06] pt-2">
            <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-chrome-300/60">Disponível</span>
            <span class="font-display text-[12px] font-bold text-white" style="font-feature-settings:'tnum';">R$ 113.478,27</span>
          </div>
        </div>
      </div>
    </div>

    <!-- stats -->
    <div class="reveal mt-14 grid grid-cols-2 gap-x-4 gap-y-6 border-t border-[--line-1] pt-7 sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-10">
      {stats.map((s, i) => (
        <>
          {i > 0 && <span class="hidden h-5 w-px bg-white/[0.08] sm:block"></span>}
          <div class="flex flex-col items-center gap-1.5 sm:flex-row sm:items-baseline sm:gap-2">
            <span class="hero-stat whitespace-nowrap font-display font-extrabold leading-none text-white"
              style="font-feature-settings:'tnum';font-size:clamp(22px,2.4vw,28px);letter-spacing:-0.02em;"
              data-stat={s.n} data-prefix={s.prefix} data-suffix={s.suffix} data-dec={s.dec}>{s.big}</span>
            <span class="whitespace-nowrap font-mono text-[9px] uppercase tracking-[0.14em] text-chrome-300/60 sm:text-[10px]">{s.label}</span>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const els = document.querySelectorAll('.hero-stat');
    if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const run = (el) => {
      const target = parseFloat(el.dataset.stat);
      const dec = parseInt(el.dataset.dec || '0');
      const pre = el.dataset.prefix || '';
      const suf = el.dataset.suffix || '';
      const t0 = performance.now();
      const dur = 1400;
      const tick = (t) => {
        const p = Math.min((t - t0) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 4);
        el.textContent = pre + (target * eased).toLocaleString('pt-BR', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    els.forEach((el) => io.observe(el));
  })();
</script>

<style>
  .persona-cta {
    display: flex; flex-direction: column; gap: 6px;
    padding: 14px 18px;
    border-radius: 16px;
    text-align: left;
    transition: transform 0.45s var(--ease-spring), background-color 0.3s, border-color 0.3s;
    position: relative;
    overflow: hidden;
  }
  .persona-cta:hover { transform: translateY(-1px); }
  .persona-cta:active { transform: scale(0.985); }
  .persona-cta.primary {
    background: var(--blue);
    border: 1px solid rgba(168,204,255,0.3);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .persona-cta.primary:hover { background: #4A8DF8; }
  .persona-cta.ghost {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--line-2);
    color: #fff;
  }
  .persona-cta.ghost:hover { background: rgba(255,255,255,0.05); border-color: var(--line-3); }
  .persona-q {
    font-family: var(--font-mono);
    font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
  }
  .persona-cta.ghost .persona-q { color: rgba(176,179,184,0.65); }
  .persona-a { display: inline-flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 700; color: #fff; }
  .persona-a small { font-weight: 400; opacity: 0.7; font-size: 12px; }
  .persona-cta .h-4 { transition: transform .3s var(--ease-spring); }
  .persona-cta:hover .h-4 { transform: translateX(3px); }
</style>

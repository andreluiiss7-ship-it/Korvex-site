---
import { WHATSAPP_URL, REGISTER_URL, STATS } from '../lib/site';
import { icon } from '../lib/icons';
import HeroCard3D from './HeroCard3D.astro';
import Mosaic from './Mosaic.astro';

const stats = [
  { big: STATS.volume,   n: STATS.volumeN,   prefix: 'R$ ', suffix: ' mi+', dec: 0, label: 'transacionados', w: 10 },
  { big: STATS.players,  n: STATS.playersN,  prefix: '',    suffix: '+',    dec: 0, label: 'operações',      w: 4 },
  { big: STATS.approval, n: STATS.approvalN, prefix: '',    suffix: '%',    dec: 0, label: 'aprovação',      w: 3.5 },
  { big: STATS.uptime,   n: STATS.uptimeN,   prefix: '',    suffix: '%',    dec: 1, label: 'uptime',         w: 5 },
];

const flow = [
  { v: 'R$ 1.997,00', m: 'Pix',    tag: 'D0' },
  { v: 'R$ 497,00',   m: 'Cartão', tag: 'D+30' },
  { v: 'R$ 6.420,00', m: 'Pix',    tag: 'D0' },
  { v: 'R$ 297,00',   m: 'Pix',    tag: 'D0' },
];

const week = [
  { d: 'S', h: 0.38 }, { d: 'T', h: 0.52 }, { d: 'Q', h: 0.46 }, { d: 'Q', h: 0.7 },
  { d: 'S', h: 0.62 }, { d: 'S', h: 0.84 }, { d: 'D', h: 1 },
];
---

<section id="topo" class="relative overflow-hidden pt-28 pb-6 sm:pt-32">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <Mosaic lit={48} seed={11} />
    <div class="hero-beam" aria-hidden="true"></div>
  </div>

  <div class="section">
    <!-- manifesto centrado -->
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="hero-h1">
        O gateway que
        <span class="hero-h1-b"><i class="hero-streak" aria-hidden="true"></i>paga no dia.</span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-pretty text-[1.05rem] leading-relaxed text-chrome-300/80 sm:text-[1.15rem]">
        Pix D0, zero reserva e taxa travada em contrato:
        <strong class="font-semibold text-white">6,99% + R$ 1,99</strong>. Gerente humano em 1h.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="hero-wa" class="btn btn-primary w-full justify-center !px-7 !py-3.5 text-[15px] sm:w-auto">
          Receber proposta em 1h
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
        <a href={REGISTER_URL} target="_blank" rel="noopener" data-cta="hero-register" class="btn btn-ghost w-full justify-center !px-7 !py-3.5 text-[15px] sm:w-auto">
          Abrir conta grátis
        </a>
      </div>

      <p class="mt-4 font-mono text-[10.5px] uppercase tracking-[0.18em] text-chrome-300/70">
        Sem setup · Sem mensalidade · Sem mínimo
      </p>
      <p class="hero-proof mt-3">
        <span class="hero-proof-dot"></span>
        <b>{STATS.volume}</b> transacionados · <b>{STATS.players}</b> operações · <b>{STATS.approval}</b> de aprovação
      </p>
    </div>

    <!-- painel de produto -->
    <div class="hero-stage relative mx-auto mt-12 max-w-[1080px] lg:mt-16">
      <div class="hero-scroll">
      <div class="hero-panel browser kframe blue in relative glow-blue tilt" data-tilt="2">
        <div class="browser-bar">
          <span class="dot bg-[#ff5f57]/80"></span><span class="dot bg-[#febc2e]/80"></span><span class="dot bg-[#28c840]/80"></span>
          <span class="ml-2 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">app.korvex.com.br/painel</span>
          <span class="ml-3 flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-chrome-300/60">
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live-400"></span>
            </span>
            Ao vivo
          </span>
        </div>

        <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
          <!-- saldo -->
          <div>
            <p class="anchor-l !mt-0">Disponível pra saque hoje</p>
            <p class="anchor-num mt-2" style="font-size:clamp(2.3rem,5vw,4rem)" data-counter data-target="113478.27" data-decimals="2" data-prefix="R$ ">R$ 113.478,27</p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <span class="mock-btn">
                Sacar agora via Pix
                <span class="h-4 w-4" set:html={icon('arrow')}></span>
              </span>
              <span class="chip"><span set:html={icon('bolt')} />Pix D0</span>
              <span class="chip"><span set:html={icon('coin')} />Cripto</span>
            </div>
            <p class="mt-3 font-mono text-[10.5px] uppercase tracking-[0.14em] text-chrome-300/50">Cai em segundos · Sem reserva</p>

            <div class="mt-7 border-t border-[--line-1] pt-5">
              <div class="flex items-baseline justify-between">
                <p class="anchor-l !mt-0">Últimos 7 dias</p>
                <p class="whitespace-nowrap font-display text-[14px] font-semibold text-white" style="font-feature-settings:'tnum';">R$ 284.910,00</p>
              </div>
              <div class="hero-week mt-3">
                {week.map((w) => (
                  <span class="hero-bar" style={`--h:${w.h}`}><i></i><b>{w.d}</b></span>
                ))}
              </div>
            </div>
          </div>

          <!-- aprovações ao vivo -->
          <div class="lg:border-l lg:border-[--line-1] lg:pl-10">
            <div class="flex items-center justify-between">
              <p class="anchor-l !mt-0">Aprovações · ao vivo</p>
              <span class="h-1.5 w-1.5 rounded-full bg-live-400"></span>
            </div>
            <div class="mt-3 space-y-2" id="hero-feed">
              {flow.map((tx, i) => (
                <div class="hero-tx">
                  <span class="h-1.5 w-1.5 rounded-full bg-live-400/80"></span>
                  <span class="truncate font-mono text-[12.5px] font-semibold text-white" style="font-feature-settings:'tnum';">{tx.v}</span>
                  <span class="truncate text-[11px] text-chrome-300/60">{tx.m}</span>
                  <span class={`rounded px-1.5 py-0.5 font-mono text-[9px] font-bold ${tx.tag === 'D0' ? 'bg-live-400/15 text-live-400' : 'bg-white/[0.06] text-chrome-300/70'}`}>{tx.tag}</span>
                </div>
              ))}
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-[--line-1] pt-3">
              <span class="font-mono text-[9.5px] uppercase tracking-[0.16em] text-chrome-300/50">Hoje</span>
              <span class="font-display text-[13px] font-bold text-white" style="font-variant-numeric:tabular-nums;"><span id="hero-today">R$ 42.310,00</span> aprovados</span>
            </div>
          </div>
        </div>
      </div>

      </div>

      <!-- cartão 3D flutuando no canto do painel (desktop) -->
      <div class="pointer-events-none absolute -right-8 -top-[150px] z-20 hidden w-[250px] xl:block" aria-hidden="true">
        <HeroCard3D />
      </div>
    </div>

    <!-- stats -->
    <div class="reveal mt-10 hidden border-t border-[--line-1] pt-6 lg:flex lg:flex-wrap lg:items-center lg:justify-center lg:gap-x-10">
      {stats.map((s, i) => (
        <>
          {i > 0 && <span class="hidden h-5 w-px bg-white/[0.08] sm:block"></span>}
          <div class="flex flex-col items-center gap-1.5 sm:flex-row sm:items-baseline sm:gap-2">
            <span class="hero-stat inline-block whitespace-nowrap text-right font-display font-extrabold leading-none text-white"
              style={`font-variant-numeric:tabular-nums;font-size:clamp(22px,2.4vw,28px);letter-spacing:-0.02em;min-width:${s.w}ch`}
              data-counter data-target={s.n} data-prefix={s.prefix} data-suffix={s.suffix} data-decimals={s.dec}>{s.big}</span>
            <span class="whitespace-nowrap font-mono text-[9px] uppercase tracking-[0.14em] text-chrome-300/60 sm:text-[10px]">{s.label}</span>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // barras da semana crescem quando entram na tela
    const week = document.querySelector('.hero-week');
    if (week) {
      if (reduce) week.classList.add('grow');
      else new IntersectionObserver((es, io) => { if (es[0].isIntersecting) { week.classList.add('grow'); io.disconnect(); } }, { threshold: 0.4 }).observe(week);
    }
    // aprovações ao vivo: entra uma linha nova a cada 4 s
    const feed = document.getElementById('hero-feed');
    const today = document.getElementById('hero-today');
    if (!feed || reduce) return;
    const pool = [
      ['R$ 1.997,00', 'Pix', 'D0'], ['R$ 497,00', 'Cartão', 'D+30'], ['R$ 6.420,00', 'Pix', 'D0'],
      ['R$ 297,00', 'Pix', 'D0'], ['R$ 2.490,00', 'Cartão', 'D+30'], ['R$ 997,00', 'Pix', 'D0'],
    ];
    let i = 3, total = 42310;
    const fmt = (n) => 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const tick = () => {
      if (document.hidden) return;
      const [v, m, tag] = pool[i % pool.length]; i++;
      const row = document.createElement('div');
      row.className = 'hero-tx hero-tx--new';
      row.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-live-400/80"></span><span class="truncate font-mono text-[12.5px] font-semibold text-white" style="font-variant-numeric:tabular-nums">${v}</span><span class="truncate text-[11px] text-chrome-300/60">${m}</span><span class="rounded px-1.5 py-0.5 font-mono text-[9px] font-bold ${tag === 'D0' ? 'bg-live-400/15 text-live-400' : 'bg-white/[0.06] text-chrome-300/70'}">${tag}</span>`;
      feed.prepend(row);
      requestAnimationFrame(() => row.classList.remove('hero-tx--new'));
      const rows = feed.querySelectorAll('.hero-tx');
      if (rows.length > 4) rows[rows.length - 1].remove();
      total += parseFloat(v.replace('R$ ', '').replace('.', '').replace(',', '.'));
      if (today) today.textContent = fmt(total);
    };
    setInterval(tick, 4000);
  })();
</script>


<style>
  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 6.6vw, 5.2rem);
    letter-spacing: -0.035em;
    line-height: 0.96;
    text-wrap: balance;
  }
  .hero-h1-b { position: relative; display: block; color: var(--blue-2); }
  .hero-streak { position: absolute; left: 50%; top: 50%; width: 140%; height: 1.6em; transform: translate(-50%, -50%); z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 50% 60% at 50% 50%, rgba(59,130,246,0.42), transparent 70%); filter: blur(18px); }
  .hero-beam { position: absolute; left: 50%; top: -12%; width: min(1400px, 160vw); height: 78%; transform: translateX(-50%); pointer-events: none;
    background: conic-gradient(from 180deg at 50% 0%, transparent 43%, rgba(59,130,246,0.16) 49%, rgba(111,160,255,0.22) 50%, rgba(59,130,246,0.16) 51%, transparent 57%);
    filter: blur(26px); opacity: .9; }
  .hero-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; height: 72px; align-items: end; }
  .hero-bar { display: grid; grid-template-rows: 1fr auto; height: 100%; gap: 6px; }
  .hero-bar i { display: block; align-self: end; height: calc(var(--h) * 100%); min-height: 6px; border-radius: 5px 5px 2px 2px; background: var(--accent-live); opacity: calc(0.35 + var(--h) * 0.65); transform: scaleY(0); transform-origin: bottom; transition: transform .9s var(--ease-out); }
  .hero-bar:nth-child(2) i { transition-delay: .06s } .hero-bar:nth-child(3) i { transition-delay: .12s } .hero-bar:nth-child(4) i { transition-delay: .18s }
  .hero-bar:nth-child(5) i { transition-delay: .24s } .hero-bar:nth-child(6) i { transition-delay: .3s } .hero-bar:nth-child(7) i { transition-delay: .36s }
  .hero-week.grow .hero-bar i { transform: scaleY(1); }
  .hero-bar b { font-family: var(--font-mono); font-weight: 400; font-size: 9px; letter-spacing: .1em; text-align: center; color: var(--t-3); }
  .hero-proof { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; color: var(--t-2); }
  .hero-proof b { font-weight: 600; color: #fff; }
  .hero-proof-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent-live); box-shadow: 0 0 10px rgba(52,211,153,.7); }
  .mock-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px; background: var(--accent-product); color: #fff; font-weight: 600; font-size: 13.5px; box-shadow: inset 0 1px 0 rgba(255,255,255,.18); }
  .mock-btn .h-4 { width: 16px; height: 16px; }
  .hero-tx--new { opacity: 0; transform: translateY(-8px); }
  .hero-tx { transition: opacity .35s var(--ease-out), transform .35s var(--ease-out); }
  .hero-tx { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,0.03); }
  @media (max-width: 1023px) { .hero-tx:nth-child(n+3) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-bar i { transform: none; transition: none; } }
</style>

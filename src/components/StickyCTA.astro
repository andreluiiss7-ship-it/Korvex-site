---
import { WHATSAPP_URL } from '../lib/site';
import { icon } from '../lib/icons';
---

<!-- CTA fixo no mobile: aparece após 12% de scroll, some perto do CTA final -->
<div id="sticky-cta" class="fixed inset-x-3 bottom-3 z-50 translate-y-[120%] opacity-0 transition-all duration-500 sm:hidden" style="transition-timing-function:var(--ease-out);">
  <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="sticky-wa"
     class="flex items-center justify-between gap-3 rounded-2xl border border-white/[0.12] bg-[--bg-1]/95 px-4 py-3 shadow-depth backdrop-blur-xl">
    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-chrome-300/80">6,99% · Pix D0</span>
    <span class="btn btn-primary !px-4 !py-2 text-[13px]">
      Receber proposta em 1h
      <span class="h-3.5 w-3.5" set:html={icon('arrow')}></span>
    </span>
  </a>
</div>

<script is:inline>
  (() => {
    const bar = document.getElementById('sticky-cta');
    if (!bar) return;
    const finalCta = document.getElementById('contato');
    let visible = false;
    const onScroll = () => {
      const pct = scrollY / (document.documentElement.scrollHeight - innerHeight);
      const nearEnd = finalCta && finalCta.getBoundingClientRect().top < innerHeight;
      const show = pct > 0.12 && !nearEnd;
      if (show !== visible) {
        visible = show;
        bar.style.transform = show ? 'translateY(0)' : 'translateY(120%)';
        bar.style.opacity = show ? '1' : '0';
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

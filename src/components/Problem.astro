---
import { icon } from '../lib/icons';
import { REGISTER_URL } from '../lib/site';

const gw = ['Hotmart', 'Kiwify', 'Kirvano', 'Ticto', 'Korvex'];
// Taxa anunciada (% + fixo). Barra proporcional ao %, máx 9,9.
const fee = [
  { pct: 9.9,  fixed: '',          w: 1 },
  { pct: 8.99, fixed: '+ R$ 2,49', w: 0.908 },
  { pct: 7.49, fixed: '+ R$ 1,00', w: 0.757 },
  { pct: 6.99, fixed: '+ R$ 2,49', w: 0.706 },
  { pct: 6.99, fixed: '+ R$ 1,99', w: 0.706 },
];
// Reserva / retenção sobre a venda. Barra proporcional, máx 40.
const res = [
  { v: '10%',     note: 'ao acelerar o cartão',  w: 0.25 },
  { v: '4 a 10%', note: 'do saldo',             w: 0.25 },
  { v: '10%',     note: 'do Pix até D+60',       w: 0.25 },
  { v: '40%',     note: 'na antecipação',        w: 1 },
  { v: 'zero',    note: '',                      w: 0 },
];
// Pix cai em: índice 0 = D0, 1 = D+1, 2 = D+2
const pix = [
  { d: 2, label: 'D+2' },
  { d: 2, label: 'D+2' },
  { d: 0, label: 'D0*' },
  { d: 0, label: 'D0' },
  { d: 0, label: 'D0' },
];
---

<section id="problema" class="sec relative">
  <div class="section">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="kicker !hidden lg:!inline-flex">A conta que ninguém te mostra</span>
      <h2 class="h2 mt-4">
        Eles anunciam a taxa.
        <span class="block font-editorial italic font-normal text-chrome-300/60">Escondem o resto.</span>
      </h2>
      <p class="lead mx-auto mt-4 hidden lg:block">
        Reserva, Pix em dois dias, taxa por saque. Tudo miúdo, tudo seu.
      </p>
    </div>

    <div class="cmp reveal mt-[--gap-lg]">
      <div class="seg lg:hidden" role="tablist" aria-label="Comparativo">
        {[['taxa', 'Taxa'], ['reserva', 'Reserva'], ['pix', 'Pix']].map(([k, l], j) => (
          <button type="button" role="tab" data-seg={k} aria-selected={j === 0 ? 'true' : 'false'} class={`seg-tab${j === 0 ? ' active' : ''}`}>
            <span class="ck-br">[</span><span class="ck-label">{l}</span><span class="ck-br">]</span>
          </button>
        ))}
      </div>

      <div class="charts">
        <!-- taxa -->
        <div class="chart on" data-view="taxa">
          <p class="chart-t">Taxa anunciada</p>
          <ul class="reveal-stagger">
            {gw.map((g, i) => (
              <li class={`bar-row${i === 4 ? ' is-k' : ''}`}>
                <span class="bar-n">{g}</span>
                <span class="bar"><i style={`--w:${fee[i].w}`}></i></span>
                <span class="bar-v">{fee[i].pct.toLocaleString('pt-BR')}%<small>{fee[i].fixed}</small></span>
              </li>
            ))}
          </ul>
        </div>

        <!-- reserva -->
        <div class="chart" data-view="reserva">
          <p class="chart-t">Reserva retida da venda</p>
          <ul class="reveal-stagger">
            {gw.map((g, i) => (
              <li class={`bar-row${i === 4 ? ' is-k' : ''}`}>
                <span class="bar-n">{g}</span>
                <span class="bar"><i style={`--w:${res[i].w}`}></i></span>
                <span class="bar-v">{res[i].v}<small>{res[i].note}</small></span>
              </li>
            ))}
          </ul>
        </div>

        <!-- pix -->
        <div class="chart" data-view="pix">
          <p class="chart-t">Seu Pix cai em</p>
          <ul class="reveal-stagger">
            {gw.map((g, i) => (
              <li class={`bar-row${i === 4 ? ' is-k' : ''}`}>
                <span class="bar-n">{g}</span>
                <span class="days" aria-hidden="true">
                  {[0, 1, 2].map((d) => <b class={d === pix[i].d ? 'on' : d < pix[i].d ? 'past' : ''}></b>)}
                </span>
                <span class="bar-v">{pix[i].label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="tb-note hidden lg:block">
        * Kirvano: 90% do Pix em D0, 10% retido até D+60. Ticto: antecipa 60%, retém 40%. Fontes: centrais de ajuda oficiais, setembro de 2026.
      </p>

      <!-- calculadora embutida -->
      <div id="calculadora" class="calc reveal mt-[--gap-lg]">
        <div>
          <label for="calc-slider" class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-chrome-300/60">Seu faturamento mensal</label>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-display text-3xl font-bold text-white sm:text-4xl" id="calc-rev" style="font-feature-settings:'tnum';">R$ 300.000</span>
            <span class="text-xs text-chrome-300/60">/mês</span>
          </div>
          <input id="calc-slider" type="range" min="50000" max="2000000" step="10000" value="300000" class="calc-slider mt-5 w-full" aria-label="Faturamento mensal" />
          <div class="mt-1.5 flex justify-between font-mono text-[10px] text-chrome-300/40">
            <span>R$ 50K</span><span>R$ 1MM</span><span>R$ 2MM</span>
          </div>
          <p class="mt-5 hidden max-w-sm text-[13.5px] leading-relaxed text-chrome-300/65 lg:block">
            12% de custo real no gateway comum contra 7% na Korvex.
          </p>
        </div>

        <div class="kframe calc-box">
          <div class="calc-row">
            <span class="calc-l"><span class="calc-i" set:html={icon('x')} />Gateway comum</span>
            <b class="calc-v text-chrome-300/85" id="calc-loss">R$ 36.000</b>
            <span class="calc-u">/mês</span>
          </div>
          <div class="calc-row">
            <span class="calc-l text-titan-300"><span class="calc-i" set:html={icon('check')} />Korvex</span>
            <b class="calc-v text-titan-gradient" id="calc-save">+R$ 15.000</b>
            <span class="calc-u">/mês</span>
          </div>
          <div class="calc-row calc-row--gold">
            <span class="calc-l text-gold-300"><span class="calc-i" set:html={icon('trophy')} />12 meses</span>
            <b class="calc-v text-gold-gradient" id="calc-year">R$ 180.000</b>
            <span class="calc-u">de volta</span>
          </div>
          <a href={REGISTER_URL} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full justify-center !py-3">
            Quero de volta
            <span class="h-4 w-4" set:html={icon('arrow')}></span>
          </a>
        </div>
      </div>

      <p class="cmp-punch reveal">
        <b class="text-gold-gradient">R$ 50.000</b> <span class="font-editorial italic text-chrome-100">ficam com você</span> a cada R$ 1 milhão. E caem no dia.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const slider = document.getElementById('calc-slider');
    const rev = document.getElementById('calc-rev');
    const loss = document.getElementById('calc-loss');
    const save = document.getElementById('calc-save');
    const year = document.getElementById('calc-year');
    if (!slider) return;
    const fmt = (n) => 'R$ ' + n.toLocaleString('pt-BR', { maximumFractionDigits: 0 });
    const COMPETITOR = 0.12;
    const KORVEX = 0.07;
    const current = { loss: 0, save: 0, year: 0 };
    let raf = null;
    const animateTo = (t) => {
      if (raf) cancelAnimationFrame(raf);
      const from = { ...current };
      const t0 = performance.now();
      const dur = 300;
      const tick = (now) => {
        const p = Math.min((now - t0) / dur, 1);
        const e = 1 - Math.pow(1 - p, 3);
        current.loss = from.loss + (t.loss - from.loss) * e;
        current.save = from.save + (t.save - from.save) * e;
        current.year = from.year + (t.year - from.year) * e;
        loss.textContent = fmt(current.loss);
        save.textContent = '+' + fmt(current.save);
        year.textContent = fmt(current.year);
        if (p < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };
    const update = () => {
      const r = parseFloat(slider.value);
      rev.textContent = fmt(r);
      const saveM = r * (COMPETITOR - KORVEX);
      animateTo({ loss: r * COMPETITOR, save: saveM, year: saveM * 12 });
    };
    slider.addEventListener('input', update);
    update();
  })();
  (() => {
    const tabs = document.querySelectorAll('.seg-tab[data-seg]');
    const charts = document.querySelectorAll('.chart[data-view]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const k = t.dataset.seg;
      tabs.forEach((x) => { const on = x === t; x.classList.toggle('active', on); x.setAttribute('aria-selected', String(on)); });
      charts.forEach((c) => {
        const on = c.dataset.view === k;
        c.classList.toggle('on', on);
        if (on) c.querySelectorAll('.bar-row').forEach((r, i) => { r.classList.remove('in'); setTimeout(() => r.classList.add('in'), 40 + i * 70); });
      });
    }));
  })();
</script>

<style>
  .cmp { max-width: 1040px; margin-inline: auto; }
  .cmp-grid { display: grid; gap: 28px; }
  @media (min-width: 1024px) { .cmp-grid { grid-template-columns: 1.45fr 0.55fr; gap: clamp(28px, 4vw, 56px); align-items: start; } }

  /* gráficos */
  .charts { display: grid; gap: 22px; }
  @media (min-width: 1024px) { .charts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); } }
  @media (max-width: 1023px) { .chart:not(.on) { display: none; } }
  .seg { margin-bottom: 10px; }
  .calc-l { display: inline-flex; align-items: center; gap: 6px; }
  .calc-i { width: 14px; height: 14px; padding: 2px; border-radius: 999px; background: rgba(255,255,255,0.06); }
  .chart { border: 1px solid var(--line-1); border-radius: 18px; padding: 18px 18px 14px; background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent); }
  .chart-t { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--t-3); margin-bottom: 12px; }
  .bar-row { display: grid; grid-template-columns: 62px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 7px 0; }
  .bar-n { font-size: 12.5px; color: var(--t-3); letter-spacing: -0.01em; white-space: nowrap; }
  .bar { height: 8px; border-radius: 999px; background: var(--line-1); overflow: hidden; }
  .bar i { display: block; height: 100%; border-radius: inherit; background: var(--t-4); width: 100%; transform: scaleX(var(--w)); transform-origin: left; transition: transform 1.1s var(--ease-out); }
  .bar-v { font-family: var(--font-display); font-weight: 700; font-size: 14px; color: var(--t-2); font-feature-settings: 'tnum'; text-align: right; line-height: 1.1; min-width: 44px; }
  .bar-v small { display: block; font-family: var(--font-mono); font-weight: 400; font-size: 9.5px; letter-spacing: 0.04em; color: var(--t-4); margin-top: 2px; white-space: nowrap; }
  .days { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .days b { display: block; height: 8px; border-radius: 999px; background: var(--line-1); }
  .days b.past { background: var(--t-4); }
  .days b.on { background: var(--t-3); }
  .bar-row.is-k { margin-top: 6px; padding: 10px 10px; margin-inline: -10px; border-radius: 12px; background: linear-gradient(90deg, rgba(59,130,246,0.12), rgba(59,130,246,0.03)); border: 1px solid rgba(111,163,224,0.28); }
  .bar-row.is-k .bar-n { color: #fff; font-weight: 600; }
  .bar-row.is-k .bar-v { color: #fff; }
  .bar-row.is-k .bar i { background: linear-gradient(90deg, var(--blue), var(--blue-2)); }
  .bar-row.is-k .days b.on { background: var(--blue-2); box-shadow: 0 0 12px rgba(111,163,224,0.6); }
  .bar-row.is-k .bar i[style="--w:0"] { transform: scaleX(0.02); }
  .bar-row:not(.in) .bar i { transform: scaleX(0); }
  .tb-note { margin-top: 14px; max-width: 78ch; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.03em; line-height: 1.55; color: var(--t-4); }

  /* calculadora */
  .calc { display: grid; gap: 24px; scroll-margin-top: 96px; }
  @media (min-width: 1024px) { .calc { grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center; } }
  .calc-box { border-radius: 22px; border: 1px solid var(--line-2); background: var(--bg-1); padding: 20px; }
  @media (min-width: 640px) { .calc-box { padding: 26px 28px; } }
  .calc-row { display: grid; grid-template-columns: 1fr auto; align-items: baseline; column-gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line-1); }
  .calc-row:first-child { padding-top: 0; }
  .calc-row--gold { border-bottom: 0; }
  .calc-l { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--t-3); }
  .calc-v { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.7rem, 3vw, 2.25rem); letter-spacing: -0.03em; line-height: 1.05; font-feature-settings: 'tnum'; }
  .calc-u { font-size: 12px; color: var(--t-3); }
  .calc-slider { -webkit-appearance: none; appearance: none; height: 6px; background: linear-gradient(to right, rgba(111,160,255,0.45), rgba(111,160,255,1)); border-radius: 999px; outline: none; }
  .calc-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 3px solid #6FA3E0; cursor: grab; box-shadow: 0 6px 16px rgba(0,0,0,0.45), 0 0 0 5px rgba(111,160,255,0.18); transition: transform .15s ease; }
  .calc-slider::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.1); }
  .calc-slider::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 3px solid #6FA3E0; cursor: grab; }

  .cmp-punch { margin-top: var(--gap-md); text-align: center; font-size: clamp(1.3rem, 2.4vw, 1.85rem); letter-spacing: -0.02em; line-height: 1.2; color: var(--t-2); text-wrap: balance; }
  .cmp-punch b { font-family: var(--font-display); font-weight: 700; }
  @media (prefers-reduced-motion: reduce) { .bar i { transition: none !important; transform: scaleX(var(--w)) !important; } }
</style>

---
import { icon } from '../lib/icons';
import { REGISTER_URL, waUrl } from '../lib/site';

const others = [
  { g: 'Hotmart', a: '9,9%',            b: 'Pix D+2' },
  { g: 'Kiwify',  a: '8,99% + R$ 2,49', b: 'Pix D+2' },
  { g: 'Kirvano', a: '7,49% + R$ 1,00', b: '10% retido até D+60' },
  { g: 'Ticto',   a: '6,99% + R$ 2,49', b: '40% retido ao antecipar' },
];
---

<section id="problema" class="sec relative" data-surface="light">
  <div class="section">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="h2">
        Mesma venda.
        <span class="block font-editorial italic font-normal text-chrome-300/60">Dois extratos.</span>
      </h2>
      <p class="lead mx-auto mt-4 hidden lg:block">
        Arraste o faturamento e veja onde o seu dinheiro para.
      </p>
    </div>

    <!-- slider -->
    <div id="calculadora" class="reveal calc mx-auto mt-[--gap-lg] max-w-2xl">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="anchor-l !mt-0">Faturamento mensal</p>
          <p class="anchor-num mt-1" style="font-size:clamp(1.9rem,4vw,2.6rem)" id="calc-rev">R$ 300.000</p>
        </div>
        <p class="hidden max-w-[22ch] text-right text-[12.5px] leading-snug text-chrome-300/55 sm:block">
          Custo real de 12% no gateway comum contra 7% na Korvex.
        </p>
      </div>
      <input id="calc-slider" type="range" min="50000" max="2000000" step="10000" value="300000" class="calc-slider mt-4 w-full" aria-label="Faturamento mensal" />
      <div class="mt-1.5 flex justify-between font-mono text-[10px] text-chrome-300/40">
        <span>R$ 50K</span><span>R$ 1MM</span><span>R$ 2MM</span>
      </div>
    </div>

    <!-- abas (mobile) -->
    <div class="seg mx-auto mt-6 max-w-[960px] lg:hidden" role="tablist" aria-label="Extratos">
      {[['comum', 'Gateway comum'], ['korvex', 'Korvex']].map(([k, l], j) => (
        <button type="button" role="tab" data-seg={k} aria-selected={j === 0 ? 'true' : 'false'} class={`seg-tab${j === 0 ? ' active' : ''}`}>
          <span class="ck-br">[</span><span class="ck-label">{l}</span><span class="ck-br">]</span>
        </button>
      ))}
    </div>

    <!-- dois extratos -->
    <div class="rc-grid mx-auto mt-3 max-w-[960px] lg:mt-8">
      <article class="rc reveal on" data-view="comum" aria-label="Extrato no gateway comum">
        <header class="rc-head">
          <span class="rc-title">Gateway comum</span>
          <span class="rc-sub">taxa anunciada 9,9%</span>
        </header>
        <div class="rc-body reveal-stagger">
          <div class="rc-line"><span>Vendas do mês</span><b id="rc-c-rev">R$ 300.000</b></div>
          <div class="rc-line"><span>Taxa anunciada 9,9%</span><b id="rc-c-fee" class="rc-neg">- R$ 29.700</b></div>
          <div class="rc-line"><span>Antecipação + taxa fixa</span><b id="rc-c-extra" class="rc-neg">- R$ 6.300</b></div>
          <div class="rc-line">
            <span><span class="rc-i" set:html={icon('clock')} />Reserva retida 10%<small>preso por até 90 dias</small></span>
            <b id="rc-c-res" class="rc-hold">R$ 30.000</b>
          </div>
          <div class="rc-line rc-line--bad">
            <span>Disponível hoje<small>Pix em D+2 · cartão em D+30</small></span>
            <b>R$ 0</b>
          </div>
        </div>
        <footer class="rc-total">
          <span>Sobra pra você</span>
          <b id="rc-c-net">R$ 264.000</b>
          <small>e <em id="rc-c-late">R$ 30.000</em> só depois de 90 dias</small>
        </footer>
      </article>

      <article class="rc rc--k kframe gold in reveal" data-view="korvex" aria-label="Extrato na Korvex">
        <header class="rc-head">
          <span class="rc-title">Korvex</span>
          <span class="rc-sub">6,99% + R$ 1,99</span>
        </header>
        <div class="rc-body reveal-stagger">
          <div class="rc-line"><span>Vendas do mês</span><b id="rc-k-rev">R$ 300.000</b></div>
          <div class="rc-line"><span>Taxa 6,99% + R$ 1,99</span><b id="rc-k-fee" class="rc-neg">- R$ 21.000</b></div>
          <div class="rc-line"><span>Antecipação escondida</span><b class="rc-ok"><span class="rc-i" set:html={icon('check')} />R$ 0</b></div>
          <div class="rc-line"><span>Reserva retida</span><b class="rc-ok"><span class="rc-i" set:html={icon('check')} />R$ 0</b></div>
          <div class="rc-line rc-line--good">
            <span>Disponível hoje<small>Pix D0, cai em segundos</small></span>
            <b><span class="rc-i" set:html={icon('bolt')} />Agora</b>
          </div>
        </div>
        <footer class="rc-total rc-total--k">
          <span>Sobra pra você</span>
          <b id="rc-k-net" class="text-gold-gradient">R$ 279.000</b>
          <small class="rc-diff"><em id="rc-diff-m">+R$ 15.000</em> por mês · <em id="rc-diff-y">R$ 180.000</em> por ano</small>
        </footer>
        <div class="rc-cta">
          <a href={REGISTER_URL} target="_blank" rel="noopener" class="btn btn-primary w-full justify-center !py-3">
            Quero esse extrato
            <span class="h-4 w-4" set:html={icon('arrow')}></span>
          </a>
          <a href={waUrl('Olá! Quero receber a proposta da Korvex pra minha operação em até 1h.')} target="_blank" rel="noopener" class="rc-link">Receber proposta em 1h</a>
        </div>
      </article>
    </div>

    <!-- concorrentes, compacto -->
    <div class="reveal mx-auto mt-8 max-w-[960px]">
      <div class="rail others lg:justify-between">
        {others.map((o) => (
          <span class="other">
            <b>{o.g}</b>
            <span>{o.a}</span>
            <span>{o.b}</span>
          </span>
        ))}
      </div>
      <p class="mt-3 hidden font-mono text-[10.5px] tracking-[0.03em] text-[--t-3] lg:block">
        Taxas e prazos das centrais de ajuda oficiais, setembro de 2026. Korvex: contrato padrão.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const slider = $('calc-slider');
    if (!slider) return;
    const out = {
      rev: [$('calc-rev'), $('rc-c-rev'), $('rc-k-rev')],
      cFee: [$('rc-c-fee')], cExtra: [$('rc-c-extra')], cRes: [$('rc-c-res'), $('rc-c-late')], cNet: [$('rc-c-net')],
      kFee: [$('rc-k-fee')], kNet: [$('rc-k-net')], diffM: [$('rc-diff-m')], diffY: [$('rc-diff-y')],
    };
    const NEG = new Set(['cFee', 'cExtra', 'kFee']);
    const fmt = (n) => 'R$ ' + Math.round(n).toLocaleString('pt-BR');
    const COMUM_FEE = 0.099, COMUM_EXTRA = 0.021, COMUM_RES = 0.10, KORVEX = 0.07;
    const cur = {}; let raf = null;
    const paint = () => {
      for (const k in out) {
        const v = cur[k];
        const txt = (NEG.has(k) ? '- ' : k === 'diffM' ? '+' : '') + fmt(v);
        out[k].forEach((el) => { if (el) el.textContent = txt; });
      }
    };
    const animateTo = (t) => {
      if (raf) cancelAnimationFrame(raf);
      const from = { ...cur }; const t0 = performance.now(); const dur = 320;
      const tick = (now) => {
        const p = Math.min((now - t0) / dur, 1); const e = 1 - Math.pow(1 - p, 3);
        for (const k in t) cur[k] = (from[k] ?? 0) + (t[k] - (from[k] ?? 0)) * e;
        paint();
        if (p < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };
    const update = () => {
      const r = parseFloat(slider.value);
      const cFee = r * COMUM_FEE, cExtra = r * COMUM_EXTRA, cRes = r * COMUM_RES;
      const cNet = r - cFee - cExtra; const kFee = r * KORVEX; const kNet = r - kFee;
      animateTo({ rev: r, cFee, cExtra, cRes, cNet, kFee, kNet, diffM: kNet - cNet, diffY: (kNet - cNet) * 12 });
    };
    slider.addEventListener('input', update);
    update();

    // abas (mobile)
    const tabs = document.querySelectorAll('.seg-tab[data-seg]');
    const views = document.querySelectorAll('.rc[data-view]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const k = t.dataset.seg;
      tabs.forEach((x) => { const on = x === t; x.classList.toggle('active', on); x.setAttribute('aria-selected', String(on)); });
      views.forEach((v) => {
        const on = v.dataset.view === k;
        v.classList.toggle('on', on);
        if (on) v.querySelectorAll('.rc-line').forEach((l, i) => { l.classList.remove('in'); setTimeout(() => l.classList.add('in'), 40 + i * 70); });
      });
    }));
  })();
</script>

<style>
  .calc-slider { -webkit-appearance: none; appearance: none; height: 6px; background: linear-gradient(to right, rgba(255,255,255,0.18), rgba(255,255,255,0.5)); border-radius: 999px; outline: none; }
  .calc-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 3px solid var(--accent-product); cursor: grab; box-shadow: 0 6px 16px rgba(0,0,0,0.45), 0 0 0 5px rgba(59,130,246,0.18); transition: transform .15s ease; }
  .calc-slider::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.1); }
  .calc-slider::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 3px solid var(--accent-product); cursor: grab; }

  .rc-grid { display: grid; gap: 20px; }
  @media (min-width: 1024px) { .rc-grid { grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; } }
  @media (max-width: 1023px) { .rc:not(.on) { display: none; } }

  .rc { position: relative; border-radius: 18px; border: 1px solid var(--line-2); background: var(--bg-1); padding: 22px 22px 20px; font-family: var(--font-mono); }
  .rc::before { content: ''; position: absolute; left: 14px; right: 14px; top: -1px; height: 8px; background: radial-gradient(circle at 4px 0, transparent 3.5px, var(--bg-0) 4px) 0 0 / 12px 8px repeat-x; opacity: .9; pointer-events: none; }
  .rc--k { border-color: rgba(201,163,94,0.35); background: linear-gradient(180deg, rgba(201,163,94,0.06), transparent 40%), var(--bg-1); }
  .rc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px dashed var(--line-3); }
  .rc-title { font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: #fff; text-transform: uppercase; }
  .rc--k .rc-title { color: var(--gold-2); }
  .rc-sub { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--t-3); white-space: nowrap; }
  .rc-line { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 12px; padding: 11px 0; border-bottom: 1px dashed var(--line-2); font-size: 12.5px; color: var(--t-2); }
  .rc-line > span { display: block; }
  .rc-line small { display: block; margin-top: 2px; font-size: 10px; letter-spacing: 0.04em; color: var(--t-4); }
  .rc-line b { font-weight: 600; color: #fff; text-align: right; white-space: nowrap; font-feature-settings: 'tnum'; display: inline-flex; align-items: center; gap: 6px; justify-content: flex-end; }
  .rc-neg { color: var(--t-2) !important; }
  .rc-hold { color: var(--t-3) !important; }
  .rc-ok, .rc-line--good b { color: var(--accent-live) !important; }
  .rc-line--bad b { color: var(--t-3) !important; }
  .rc-i { width: 14px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 5px; }
  .rc-line > span .rc-i { color: var(--t-4); }
  .rc-total { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 4px 12px; padding-top: 14px; }
  .rc-total > span { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--t-3); }
  .rc-total > b { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -0.03em; line-height: 1; color: #fff; font-feature-settings: 'tnum'; }
  .rc-total > small { grid-column: 1 / -1; font-size: 10.5px; color: var(--t-4); }
  .rc-total > small em { font-style: normal; color: var(--t-3); }
  .rc-total--k > b { font-size: clamp(1.9rem, 3.4vw, 2.5rem); }
  .rc-diff { font-size: 11px !important; color: var(--t-3) !important; }
  .rc-diff em { font-style: normal; font-weight: 700; color: var(--gold-2) !important; }
  .rc-cta { margin-top: 16px; display: grid; gap: 10px; justify-items: center; }
  .rc-link { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--t-2); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(255,255,255,0.25); }
  .rc-link:hover { color: #fff; }

  .others { gap: 10px; }
  .other { display: grid; gap: 2px; min-width: 190px; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line-1); background: rgba(255,255,255,0.02); font-family: var(--font-mono); font-size: 11px; color: var(--t-3); letter-spacing: 0.02em; }
  .other b { font-family: var(--font-display); font-weight: 700; font-size: 13px; color: #fff; letter-spacing: -0.01em; }
  @media (min-width: 1024px) { .other { min-width: 0; flex: 1; } }
  [data-surface="light"] .calc-slider { background: linear-gradient(to right, rgba(11,18,32,0.14), rgba(11,18,32,0.42)); }
  [data-surface="light"] .rc { background: #FFFFFF; box-shadow: var(--shadow-card); }
  [data-surface="light"] .rc--k { background: linear-gradient(180deg, rgba(138,106,36,0.07), transparent 40%), #FFFFFF; border-color: rgba(138,106,36,0.35); }
  [data-surface="light"] .rc-title, [data-surface="light"] .rc-line b, [data-surface="light"] .rc-total > b, [data-surface="light"] .other b { color: var(--t-1); }
  [data-surface="light"] .rc-link { color: var(--t-2); text-decoration-color: rgba(11,18,32,0.3); }
  [data-surface="light"] .rc-link:hover { color: var(--t-1); }
  [data-surface="light"] .other { background: #FFFFFF; border-color: var(--line-2); }
  [data-surface="light"] .rc-total > small em, [data-surface="light"] .rc-diff em { color: var(--gold-1) !important; }
  @media (prefers-reduced-motion: reduce) { .calc-slider::-webkit-slider-thumb { transition: none; } }
</style>

---
import { icon } from '../lib/icons';

const rows = [
  { k: 'Taxa real', a: '~12%: 4,99% na vitrine, mais antecipação, reserva e spread', b: '6,99% + R$ 1,99. Só isso.' },
  { k: 'Saque',     a: 'D+14 a D+30, com fila',                                       b: 'D0 no Pix' },
  { k: 'Reserva',   a: 'Parte da venda retida por até 90 dias',                       b: 'Zero' },
  { k: 'Suporte',   a: 'Ticket, bot e espera',                                        b: 'Gerente humano em até 1h' },
];
---

<section id="problema" class="sec relative">
  <div class="section">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="kicker">A conta que ninguém te mostra</span>
      <h2 class="h2 mt-5">
        Eles dizem 4,99%.
        <span class="block font-editorial italic font-normal text-chrome-300/60">A real é o dobro.</span>
      </h2>
      <p class="lead mx-auto mt-6">
        Você assina por 4,99% e fecha o mês com <strong>12% no buraco</strong>: antecipação, reserva, chargeback, spread. Cada nome, um pedaço seu.
      </p>
    </div>

    <div class="cmp reveal mt-16">
      <div class="cmp-head">
        <div>
          <span class="chapter">Gateway comum</span>
          <p class="cmp-big"><span data-counter data-target="12" data-suffix="%">12%</span></p>
          <p class="cmp-sub">custo real por venda</p>
          <div class="cmp-bar" style="--w:1"><i></i></div>
        </div>
        <div>
          <span class="chapter cmp-k">Korvex</span>
          <p class="cmp-big cmp-big--k"><span data-counter data-target="7" data-suffix="%">7%</span></p>
          <p class="cmp-sub">tudo incluso, sem letra miúda</p>
          <div class="cmp-bar cmp-bar--k" style="--w:0.583"><i></i></div>
        </div>
      </div>

      <dl class="cmp-rows reveal-stagger">
        {rows.map((r) => (
          <div class="cmp-row">
            <dt>{r.k}</dt>
            <dd class="cmp-a">{r.a}</dd>
            <dd class="cmp-b"><span class="cmp-check" set:html={icon('check')} />{r.b}</dd>
          </div>
        ))}
      </dl>

      <p class="cmp-punch reveal">
        <b class="text-gold-gradient">R$ 50.000</b> <span class="font-editorial italic text-chrome-100">ficam com você</span> a cada R$ 1 milhão.
      </p>
    </div>
  </div>
</section>

<style>
  .cmp { max-width: 960px; margin-inline: auto; }
  .cmp-head { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 48px); align-items: end; }
  .cmp-k { color: var(--blue-2); }
  .cmp-big {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--t-3);
    font-feature-settings: 'tnum';
  }
  .cmp-big--k { color: #fff; }
  .cmp-sub { margin-top: 8px; font-size: 13px; color: var(--t-3); }
  .cmp-bar { margin-top: 18px; height: 6px; border-radius: 999px; background: var(--line-1); overflow: hidden; }
  .cmp-bar i {
    display: block; height: 100%; width: 100%; border-radius: inherit;
    background: var(--t-4);
    transform: scaleX(0); transform-origin: left;
    transition: transform 1.4s var(--ease-out) 0.2s;
  }
  .cmp-bar--k i { background: linear-gradient(90deg, var(--blue), var(--blue-2)); transition-delay: 0.35s; }
  .reveal.in .cmp-bar i { transform: scaleX(var(--w)); }

  .cmp-rows { margin-top: 44px; border-top: 1px solid var(--line-2); }
  .cmp-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 8px clamp(20px, 4vw, 48px);
    padding: 18px 0;
    border-bottom: 1px solid var(--line-1);
  }
  .cmp-row dt { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--t-3); }
  .cmp-row dd { font-size: 14.5px; line-height: 1.45; max-width: 44ch; }
  .cmp-a { color: var(--t-3); }
  .cmp-b { color: var(--t-1); display: flex; gap: 10px; align-items: flex-start; }
  .cmp-check { flex: none; width: 18px; height: 18px; margin-top: 1px; padding: 3px; border-radius: 999px; background: var(--blue-tint); color: var(--blue-2); }
  @media (min-width: 768px) {
    .cmp-row { grid-template-columns: 140px 1fr 1fr; padding: 22px 0; align-items: baseline; }
    .cmp-row dt { grid-column: auto; }
    .cmp-head { padding-left: calc(140px + clamp(20px, 4vw, 48px)); }
  }
  .cmp-punch {
    margin-top: 44px; text-align: center;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.02em; line-height: 1.2;
    color: var(--t-2); text-wrap: balance;
  }
  .cmp-punch b { font-family: var(--font-display); font-weight: 700; }
  @media (prefers-reduced-motion: reduce) { .cmp-bar i { transition: none; transform: scaleX(var(--w)); } }
</style>

---
import IconRow from './IconRow.astro';
const stats = [
  { big: 'R$ 25M+', label: 'vendidos online', n: 25, prefix: 'R$ ', suffix: 'M+' },
  { big: '1h', label: 'resposta do gerente' },
];
---

<section id="fundador" class="sec relative" data-surface="light">
  <div class="section">
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
      <!-- copy -->
      <div class="reveal">
        <h2 class="h2">
          Construída por quem<br />
          <span class="font-editorial italic font-normal" style="color:var(--t-2)">já teve saque preso.</span>
        </h2>
        <p class="lead mt-4">
          André vendeu <strong>R$ 25 milhões</strong> online antes da Korvex.
          Cada regra daqui existe pra o que ele passou não acontecer com você.
        </p>
        <dl class="reveal-stagger mt-7 grid grid-cols-2 gap-x-6 border-t border-[--line-2] pt-6 sm:gap-x-12">
          {stats.map((s) => (
            <div>
              <dt class="anchor-num whitespace-nowrap" style="font-size:clamp(1.9rem,4vw,2.9rem)" data-counter={s.n !== undefined ? '' : undefined} data-target={s.n} data-prefix={s.prefix} data-suffix={s.suffix}>{s.big}</dt>
              <dd class="anchor-l">{s.label}</dd>
            </div>
          ))}
        </dl>
        <IconRow class="mt-7" variant="x" items={[
          { icon: 'x', label: 'Taxa mudada por e-mail' },
          { icon: 'x', label: 'Saldo em análise' },
          { icon: 'x', label: 'Suporte por robô' },
        ]} />
      </div>

      <!-- retrato: objeto escuro sobre papel -->
      <div class="reveal founder-frame kframe relative overflow-hidden rounded-[22px]">
        <img
          src="/assets/founder-andre.jpg"
          alt="André, fundador da Korvex"
          width="600" height="800"
          class="founder-photo absolute inset-0 h-full w-full object-cover"
          loading="lazy" decoding="async"
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-36" style="background: linear-gradient(0deg, rgba(5,11,20,0.9), rgba(5,11,20,0.35) 55%, transparent)"></div>
        <div class="absolute inset-x-6 bottom-6 z-10">
          <p class="font-display text-[15px] font-semibold leading-tight text-white">André</p>
          <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/70">Fundador · Korvex</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-frame { aspect-ratio: 4 / 5; width: 100%; background: #050B14; box-shadow: 0 30px 60px -30px rgba(11, 18, 32, 0.5); }
  @media (min-width: 640px)  { .founder-frame { aspect-ratio: 4 / 3; } }
  @media (min-width: 1024px) { .founder-frame { aspect-ratio: 4 / 5; max-height: 560px; } }
  .founder-frame.kframe::after { --kc: rgba(255, 255, 255, 0.4); }
  .founder-photo {
    object-position: center 30%;
    filter: saturate(0.9);
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1s var(--ease-out), transform 1.2s var(--ease-out);
  }
  .reveal.in .founder-photo { opacity: 1; transform: none; }
</style>

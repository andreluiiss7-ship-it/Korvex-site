---
import IconRow from './IconRow.astro';
const stats = [
  { big: 'R$ 25M+', label: 'vendidos online', n: 25, prefix: 'R$ ', suffix: 'M+' },
  { big: '1h', label: 'resposta do gerente' },
];
---

<section id="fundador" class="sec relative">
  <div class="section">
    <div class="reveal grid items-stretch gap-6 overflow-hidden rounded-[var(--radius-xl)] border border-[--line-1] bg-[--bg-1] shadow-depth lg:grid-cols-[1fr_1fr] lg:gap-0">
      <!-- copy -->
      <div class="relative p-7 sm:p-8 lg:p-10">
        <span class="chapter hidden lg:inline-flex">Quem construiu</span>
        <h2 class="h2 mt-4">
          Construída por quem<br />
          <span class="font-editorial italic font-normal text-titan-gradient">já teve saque preso.</span>
        </h2>
        <p class="lead mt-4 hidden lg:block">
          André vendeu <strong class="text-white">R$ 25 milhões</strong> online antes da Korvex.
          Cada regra daqui existe pra o que ele passou não acontecer com você.
        </p>
        <dl class="reveal-stagger mt-6 grid grid-cols-2 gap-x-6 gap-y-2 border-t border-[--line-1] pt-5 sm:gap-x-12">
          {stats.map((s) => (
            <div>
              <dt class="anchor-num whitespace-nowrap" style="font-size:clamp(1.7rem,4vw,2.75rem)" data-counter={s.n !== undefined ? '' : undefined} data-target={s.n} data-prefix={s.prefix} data-suffix={s.suffix}>{s.big}</dt>
              <dd class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-chrome-300/60">{s.label}</dd>
            </div>
          ))}
        </dl>
        <IconRow class="mt-6" variant="x" items={[
          { icon: 'x', label: 'Taxa mudada por e-mail' },
          { icon: 'x', label: 'Saldo em análise' },
          { icon: 'x', label: 'Suporte por robô' },
        ]} />
      </div>

      <!-- retrato -->
      <div class="founder-frame kframe relative overflow-hidden">
        <img
          src="/assets/founder-andre.jpg"
          alt="André, fundador da Korvex"
          width="600" height="800"
          class="founder-photo absolute inset-0 h-full w-full object-cover"
          loading="lazy" decoding="async"
        />
        <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[--bg-1] via-[--bg-1]/40 to-transparent lg:from-[--bg-1]/85"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[--bg-1]/85 via-[--bg-1]/30 to-transparent"></div>
        <div class="absolute inset-x-6 bottom-6 z-10">
          <p class="font-display text-[15px] font-semibold leading-tight text-white">André</p>
          <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.18em] text-chrome-200/75">Fundador · Korvex</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-frame { aspect-ratio: 1 / 1; width: 100%; }
  @media (min-width: 640px)  { .founder-frame { aspect-ratio: 4 / 3; } }
  @media (min-width: 1024px) { .founder-frame { aspect-ratio: auto; height: 100%; min-height: 460px; } }
  .founder-photo {
    object-position: center 30%;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1s var(--ease-out), transform 1.2s var(--ease-out);
  }
  .reveal.in .founder-photo { opacity: 1; transform: none; }
</style>

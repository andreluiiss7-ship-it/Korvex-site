---
// "Quem te atende": fundador, as três regras de atendimento e a migração em três passos.
import { icon } from '../lib/icons';
import { WHATSAPP_URL } from '../lib/site';

const stats = [
  { big: 'R$ 25 mi+', label: 'vendidos online', n: 25, prefix: 'R$ ', suffix: ' mi+' },
  { big: '1h', label: 'resposta do gerente' },
];
const rules = [
  { t: 'Gerente humano em 1h.', d: 'Nome, WhatsApp e resposta. Não robô.' },
  { t: 'Aviso antes de qualquer ação.', d: 'Se algo parecer estranho, seu gerente fala com você primeiro.' },
  { t: 'Taxa que não muda por e-mail.', d: 'Só com a sua assinatura.' },
];
const steps = [
  { n: '01', t: 'Importe seus produtos', d: 'Traga o catálogo de outra plataforma.' },
  { n: '02', t: 'Troque o link do checkout', d: 'Na sua página de vendas e nos anúncios.' },
  { n: '03', t: 'Venda no mesmo dia', d: 'Seu gerente acompanha a virada.' },
];
---

<section id="fundador" class="sec relative" data-surface="light">
  <div class="section">
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_0.82fr] lg:gap-14">
      <div class="reveal">
        <span class="chapter hidden lg:inline-flex">Quem te atende</span>
        <h2 class="h2 mt-4">
          Construída por quem<br />
          <span class="font-editorial italic font-normal" style="color:var(--t-2)">já teve saque preso.</span>
        </h2>
        <p class="lead mt-4">
          André vendeu <strong>R$ 25 milhões</strong> online antes da Korvex.
          Cada regra daqui existe para o que ele passou não acontecer com você.
        </p>
        <dl class="reveal-stagger mt-6 grid grid-cols-2 gap-x-6 border-t border-[--line-2] pt-5 sm:gap-x-12">
          {stats.map((s) => (
            <div>
              <dt class="anchor-num whitespace-nowrap" style="font-size:clamp(1.9rem,4vw,2.7rem)" data-counter={s.n !== undefined ? '' : undefined} data-target={s.n} data-prefix={s.prefix} data-suffix={s.suffix}>{s.big}</dt>
              <dd class="anchor-l">{s.label}</dd>
            </div>
          ))}
        </dl>
        <ul class="gn-rules reveal-stagger mt-6">
          {rules.map((r) => (<li><b>{r.t}</b><span>{r.d}</span></li>))}
        </ul>
      </div>

      <div class="reveal founder-frame kframe relative overflow-hidden rounded-[22px]">
        <img
          src="/assets/founder-andre-600.webp"
          alt="André, fundador da Korvex"
          width="600" height="800"
          class="founder-photo absolute inset-x-0 w-full object-cover" style="top:-7%;height:114%" data-parallax="0.08"
          loading="lazy" decoding="async"
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-36" style="background: linear-gradient(0deg, rgba(5,11,20,0.9), rgba(5,11,20,0.35) 55%, transparent)"></div>
        <div class="absolute inset-x-6 bottom-6 z-10">
          <p class="font-display text-[15px] font-semibold leading-tight" style="color:#fff">André</p>
          <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.18em] text-white/70">Fundador · Korvex</p>
        </div>
      </div>
    </div>

    <!-- migração -->
    <div class="gn-mig reveal mt-[--gap-lg]">
      <div class="gn-mig-h">
        <h3>Trocar de plataforma em uma tarde.</h3>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="migracao-wa" class="btn btn-ghost !py-2.5 text-[13px]">
          <span class="h-4 w-4" set:html={icon('headset')}></span>
          Falar com gerente
        </a>
      </div>
      <ol class="reveal-stagger">
        {steps.map((s) => (
          <li><em>{s.n}</em><b>{s.t}</b><span>{s.d}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .founder-frame { aspect-ratio: 4 / 3; width: 100%; background: #050B14; box-shadow: 0 30px 60px -30px rgba(11, 18, 32, 0.5); }
  @media (min-width: 1024px) { .founder-frame { aspect-ratio: 4 / 5; max-height: 540px; } }
  .founder-frame.kframe::after { --kc: rgba(255, 255, 255, 0.4); }
  .founder-photo { object-position: center 30%; filter: saturate(0.9); opacity: 0; transition: opacity 1s var(--ease-out); }
  .reveal.in .founder-photo { opacity: 1; }

  .gn-rules { border-top: 1px solid var(--line-2); }
  .gn-rules li { display: grid; gap: 2px 20px; padding: 12px 0; border-bottom: 1px solid var(--line-1); font-size: 14.5px; line-height: 1.45; }
  .gn-rules b { font-family: var(--font-display); font-weight: 600; color: var(--t-1); }
  .gn-rules span { color: var(--t-2); }
  @media (min-width: 640px) { .gn-rules li { grid-template-columns: 0.9fr 1.1fr; align-items: baseline; } }
  @media (max-width: 639px) { .gn-rules span { display: none; } }

  .gn-mig { border-top: 1px solid var(--line-3); padding-top: 22px; }
  .gn-mig-h { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .gn-mig h3 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.35rem, 2.4vw, 1.9rem); letter-spacing: -0.03em; line-height: 1.1; color: var(--t-1); }
  .gn-mig ol { display: grid; margin-top: 18px; }
  .gn-mig li { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; row-gap: 2px; padding: 14px 0; border-top: 1px solid var(--line-1); }
  .gn-mig em { grid-row: 1 / 3; font-family: var(--font-mono); font-style: normal; font-size: 11px; letter-spacing: .12em; color: var(--accent-product); padding-top: 3px; }
  .gn-mig li b { font-family: var(--font-display); font-weight: 600; font-size: 16px; letter-spacing: -0.01em; color: var(--t-1); }
  .gn-mig li span { font-size: 14px; line-height: 1.45; color: var(--t-2); }
  @media (max-width: 639px) { .gn-mig li span { display: none; } .gn-mig li { padding: 12px 0; } }
  @media (min-width: 900px) {
    .gn-mig ol { grid-template-columns: repeat(3, 1fr); }
    .gn-mig li { padding: 16px 24px 4px 0; }
    .gn-mig li + li { padding-left: 24px; border-left: 1px solid var(--line-1); }
  }
</style>

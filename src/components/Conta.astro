---
// "A entrega": o que acontece depois de cada venda, contado como o registro de um pedido.
// Sem preço aqui: a página fala do serviço. Valor da taxa só na dúvida "Quanto custa?".
import { icon } from '../lib/icons';
import { REGISTER_URL, WHATSAPP_URL } from '../lib/site';

const steps = [
  { t: '0 s',    h: 'Pix pago',                    d: 'O comprador paga o QR Code no checkout.' },
  { t: '4 s',    h: 'Dinheiro no seu saldo',       d: 'Sem esperar dois dias e sem reserva retida.' },
  { t: '4 s',    h: 'Aviso no seu celular',        d: '"Venda confirmada!" no app, em iPhone e Android.' },
  { t: '5 s',    h: 'Aluno com acesso',            d: 'O acesso à área de membros chega no e-mail do comprador.' },
  { t: '30 s',   h: 'Oferta depois da compra',     d: 'Upsell no Pix em um clique, sem digitar nada de novo.' },
  { t: 'dia 12', h: 'Chegou um MED? Defesa pronta', d: 'Acessos, aulas assistidas e aceite dos termos viram a defesa. Só o valor contestado fica separado.' },
];
const kit = [
  'Checkout com 7 temas e teste A/B',
  'Upsell e parcelado no Pix',
  'Área de membros com cara de streaming',
  'Defesa de MED automática',
  'App no celular, iPhone e Android',
  'API Pix para o seu sistema',
];
---

<section id="conta" class="sec relative" data-surface="light">
  <div class="section">
    <div class="reveal grid items-end gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <span class="chapter hidden lg:inline-flex">A entrega</span>
        <h2 class="h2 mt-4">
          Vendeu.
          <span class="block font-editorial italic font-normal" style="color:var(--t-2)">O resto é com a gente.</span>
        </h2>
      </div>
      <p class="lead hidden max-w-md lg:block">
        O que acontece depois de cada Pix, sem você abrir o painel.
      </p>
    </div>

    <div class="en mt-[--gap-md]">
      <!-- registro de uma venda -->
      <div class="stage3d"><div class="lift">
        <div class="en-log kframe gold in reveal">
          <div class="en-head">
            <span>Registro da venda · Pedido 48213</span>
            <b>Pix · R$ 97,00</b>
          </div>
          <ol class="en-steps">
            {steps.map((s) => (
              <li>
                <time>{s.t}</time>
                <i class="en-dot"></i>
                <div><b>{s.h}</b><span>{s.d}</span></div>
              </li>
            ))}
          </ol>
          <p class="en-foot">Você não abriu o painel nenhuma vez.</p>
        </div>
      </div></div>

      <!-- o que vem na conta -->
      <aside class="en-side reveal">
        <p class="anchor-l !mt-0">O que vem na conta</p>
        <ul class="en-zeros">
          <li><b>0</b>reserva</li><li><b>0</b>setup</li><li><b>0</b>mensalidade</li>
        </ul>
        <ul class="en-kit">
          {kit.map((k) => (<li><i set:html={icon('check')}></i>{k}</li>))}
        </ul>
        <a href={REGISTER_URL} target="_blank" rel="noopener" data-cta="conta-register" class="btn btn-primary mt-5 w-full justify-center">
          Abrir conta grátis
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="conta-wa" class="en-link">Prefere conversar antes? Fale com um gerente</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .en { display: grid; gap: 20px; }
  @media (min-width: 1024px) { .en { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 24px; align-items: stretch; } }

  .en-log { height: 100%; border-radius: 18px; border: 1px solid var(--line-2); background: #fff; box-shadow: var(--shadow-card); padding: 22px 24px 20px; }
  .en-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding-bottom: 14px; border-bottom: 1px solid var(--line-2); font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--t-3); }
  .en-head b { padding: 5px 10px; border-radius: 99px; background: var(--accent-product-tint); color: var(--accent-product); font-weight: 700; letter-spacing: .06em; }

  /* linha do tempo: a régua se preenche com a rolagem e cada passo acende quando ela passa */
  .en-steps { position: relative; margin-top: 6px; }
  .en-steps::before, .en-steps::after { content: ''; position: absolute; left: 77px; top: 26px; bottom: 26px; width: 2px; border-radius: 2px; }
  .en-steps::before { background: var(--line-2); }
  .en-steps::after { background: var(--accent-product); transform-origin: top; }
  .en-steps li { position: relative; display: grid; grid-template-columns: 64px 28px 1fr; align-items: start; column-gap: 0; padding: 14px 0; border-bottom: 1px solid var(--line-1); }
  .en-steps li:last-child { border-bottom: 0; }
  .en-steps time { padding-top: 2px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--t-1); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .en-dot { position: relative; z-index: 1; width: 12px; height: 12px; margin: 5px 0 0 8px; border-radius: 50%; background: #fff; border: 2px solid var(--accent-product); box-shadow: 0 0 0 4px #fff; }
  .en-steps li div { display: grid; gap: 2px; padding-left: 6px; }
  .en-steps b { font-family: var(--font-display); font-weight: 700; font-size: 16.5px; letter-spacing: -0.015em; color: var(--t-1); }
  .en-steps span { font-size: 14px; line-height: 1.45; color: var(--t-2); text-wrap: pretty; }
  .en-steps li:last-child .en-dot { border-color: var(--gold-1); }
  .en-foot { margin-top: 10px; padding-top: 14px; border-top: 1px solid var(--line-2); font-family: var(--font-editorial); font-style: italic; font-size: 20px; color: var(--t-2); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .en-steps::after { animation: en-fill linear both; animation-timeline: view(); animation-range: entry 40% cover 62%; }
      .en-steps li > * { animation: en-lit linear both; animation-timeline: view(); animation-range: entry 70% cover 42%; }
      .en-steps li .en-dot { animation-name: en-dot; }
    }
  }
  @keyframes en-fill { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes en-lit { from { opacity: .28; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
  @keyframes en-dot { from { scale: .5; background: #fff; } to { scale: 1; background: var(--accent-product); } }

  .en-side { border-radius: 18px; border: 1px solid var(--line-2); background: #fff; box-shadow: var(--shadow-card); padding: 22px; }
  .en-zeros { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 14px; border-block: 1px solid var(--line-2); }
  .en-zeros li { padding: 12px 0; font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--t-3); }
  .en-zeros li + li { padding-left: 14px; border-left: 1px solid var(--line-2); }
  .en-zeros b { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; letter-spacing: -0.04em; line-height: 1; color: var(--t-1); margin-bottom: 4px; }
  .en-kit { margin-top: 6px; }
  .en-kit li { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line-1); font-size: 14.5px; color: var(--t-1); }
  .en-kit i { flex: none; width: 16px; height: 16px; color: var(--accent-live); }
  .en-kit i :global(svg) { width: 100%; height: 100%; }
  .en-link { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 4px; font-size: 13px; color: var(--t-2); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(11,18,32,0.3); text-align: center; }
  @media (hover: hover) and (pointer: fine) { .en-link:hover { color: var(--t-1); } }

  @media (max-width: 719px) {
    .en-log { padding: 18px 16px 16px; }
    .en-steps::before, .en-steps::after { left: 61px; }
    .en-steps li { grid-template-columns: 50px 26px 1fr; }
    .en-steps time { font-size: 11px; }
    .en-steps span { font-size: 13.5px; }
    .en-foot { font-size: 18px; }
    /* no celular a lista de recursos repete o capítulo Produto: fica só o essencial */
    .en-kit { display: none; }
    .en-head { font-size: 10px; }
  }
</style>

---
import { WHATSAPP_URL, REGISTER_URL } from '../lib/site';
import { icon } from '../lib/icons';

const links = [
  { label: 'Produto',    href: '#produto' },
  { label: 'Taxas',      href: '#pagamentos' },
  { label: 'Premiações', href: '#premiacoes' },
  { label: 'Fundador',   href: '#fundador' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav
    id="nav"
    class="mx-auto mt-3 flex w-[min(96%,1180px)] items-center justify-between rounded-full border border-[--line-2] bg-ink/60 px-4 py-2.5 backdrop-blur-xl transition-all duration-300 sm:px-5"
  >
    <a href="#topo" class="flex items-center gap-2.5">
      <img src="/assets/logo-white.png" alt="Korvex" width="1352" height="352" class="h-6 w-auto sm:h-7" />
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-chrome-300/80 transition-colors hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener"
        data-cta="nav-wa"
        class="hidden text-sm font-medium text-chrome-300/80 transition-colors hover:text-white xl:inline-flex"
      >
        Falar com gerente
      </a>
      <a
        href={REGISTER_URL}
        target="_blank"
        rel="noopener"
        data-cta="nav-register"
        class="btn btn-primary min-h-[44px] !px-5 !py-2.5 text-[13px]"
      >
        Abrir conta
      </a>
      <details class="nav-menu relative lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/10 text-white" aria-label="Menu">
          <span class="nav-menu-i" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="material absolute right-0 top-[52px] w-[220px] rounded-2xl p-2">
          {links.map((l) => (
            <a href={l.href} class="block rounded-xl px-3 py-2.5 text-[15px] font-medium text-white/90 hover:bg-white/5">{l.label}</a>
          ))}
          <a href="#faq" class="block rounded-xl px-3 py-2.5 text-[15px] font-medium text-white/90 hover:bg-white/5">Dúvidas</a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-cta="nav-wa" class="mt-1 block rounded-xl bg-titan-500/15 px-3 py-2.5 text-[15px] font-semibold text-white">Falar com gerente</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .nav-menu summary::-webkit-details-marker { display: none; }
  .nav-menu-i { display: grid; gap: 5px; width: 16px; }
  .nav-menu-i i { display: block; height: 1.5px; background: currentColor; border-radius: 2px; transition: transform .25s var(--ease-out); }
  .nav-menu[open] .nav-menu-i i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .nav-menu[open] .nav-menu-i i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
</style>

<script>
  const nav = document.getElementById('nav');
  // fecha o menu mobile ao clicar num link
  document.querySelectorAll('.nav-menu a').forEach((a) => a.addEventListener('click', () => (document.querySelector('.nav-menu') as HTMLDetailsElement)?.removeAttribute('open')));
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add('!bg-ink/85', 'shadow-depth');
    } else {
      nav.classList.remove('!bg-ink/85', 'shadow-depth');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

---
import { WHATSAPP_DUVIDA_URL } from '../lib/site';
import { icon } from '../lib/icons';

const cols = [
  {
    title: 'Plataforma',
    links: [
      { label: 'Checkout', href: '#checkout' },
      { label: 'Funil', href: '#produto' },
      { label: 'Área de membros', href: '#produto' },
      { label: 'Taxas', href: '#pagamentos' },
    ],
  },
  {
    title: 'Korvex',
    links: [
      { label: 'Premiações', href: '#premiacoes' },
      { label: 'Comparativo de taxas', href: '#problema' },
      { label: 'Dúvidas frequentes', href: '#faq' },
      { label: 'Falar com o time', href: WHATSAPP_DUVIDA_URL, ext: true },
      { label: 'Manifesto', href: '/manifesto' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Termos de uso', href: '/termos' },
      { label: 'Política de privacidade', href: '/privacidade' },
      { label: 'Política AML / KYC', href: '/aml-kyc' },
      { label: 'Canal de denúncias', href: 'mailto:compliance@korvex.com.br' }, // CONFIRMAR e-mail
    ],
  },
];
---

<footer class="relative mt-0 border-t border-[--line-1] pt-12">
  <div class="section pb-10">
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <img src="/assets/logo-white.png" alt="Korvex" width="1352" height="352" class="h-7 w-auto" />
        <p class="mt-4 hidden max-w-xs text-pretty text-sm leading-relaxed text-chrome-300/60 lg:block">
          O próprio dinheiro no próprio dia. Pix D0, zero reserva, taxa em contrato.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {['KYC', 'AML', 'KYT'].map((k) => <span class="chip"><span set:html={icon('shield')} />{k}</span>)}
        </div>
      </div>

      {
        cols.map((c) => (
          <div class={c.title === 'Legal' ? '' : 'hidden lg:block'}>
            <p class="hidden text-[12px] font-semibold uppercase tracking-wider text-chrome-300/60 lg:block">{c.title}</p>
            <ul class={c.title === 'Legal' ? 'flex flex-wrap gap-x-4 gap-y-2 lg:mt-4 lg:block lg:space-y-2.5' : 'mt-4 space-y-2.5'}>
              {c.links.map((l) => (
                <li>
                  <a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined} data-cta={l.ext ? 'footer-wa' : undefined} class="inline-flex min-h-[32px] items-center text-sm text-chrome-300/70 transition-colors hover:text-white">{l.label}</a>
                </li>
              ))}
              {c.title === 'Legal' && (
                <li class="lg:hidden"><a href={WHATSAPP_DUVIDA_URL} target="_blank" rel="noopener" data-cta="footer-wa" class="inline-flex min-h-[32px] items-center text-sm text-chrome-300/70 transition-colors hover:text-white">Falar com o time</a></li>
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-[--line-1]">
    <div class="section flex flex-col items-center justify-between gap-3 py-5 sm:flex-row">
      <p class="text-[12px] text-chrome-300/60">© 2026 Korvex Tecnologia. Todos os direitos reservados.</p>
      <p class="hidden text-[12px] text-chrome-300/60 lg:block">Feito para quem vende sério.</p>
    </div>
  </div>
</footer>

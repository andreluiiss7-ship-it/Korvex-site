---
// Recriação fiel do construtor de funil real da Korvex (app.korvex.com.br → Checkout → Funil de vendas).
// Produto e hashes são fictícios (persona "Método Escala").
import { icon } from '../lib/icons';

const side = [
  { g: 'Geral',     items: [['Informações'], ['Ofertas', '2']] },
  { g: 'Entregas',  items: [['Arquivos'], ['Área de membros']] },
  { g: 'Checkout',  items: [['Personalizar checkout'], ['Funil de vendas', '', true]] },
  { g: 'Parceiros', items: [['Afiliação'], ['Co produtores']] },
  { g: 'Tráfego',   items: [['Links de divulgação'], ['Integração de pixels']] },
];

// canvas 1000 × 560; nó 210 × 82
const NW = 210, NH = 82;
const nodes = [
  { id: 'f66mzsnsyo', t: 'Método Escala',   s: 'Todas as ofertas', k: 'flag',      x: 40,  y: 96 },
  { id: 'qe6lkqhwis', t: 'Mentoria + Grupo', s: 'up1',             k: 'thumbup',   x: 330, y: 214 },
  { id: '2847uirczs', t: 'Consultoria 1:1',  s: 'up2',             k: 'thumbup',   x: 700, y: 132 },
  { id: 'q3stk8i6ld', t: 'Mentoria 12x',     s: 'downsell',        k: 'thumbdown', x: 452, y: 404 },
];

const rt = (n: typeof nodes[0]) => [n.x + NW, n.y + NH / 2];
const lf = (n: typeof nodes[0]) => [n.x, n.y + NH / 2];
const bt = (n: typeof nodes[0]) => [n.x + NW / 2, n.y + NH];
const tp = (n: typeof nodes[0]) => [n.x + NW / 2, n.y];

const hz = (a: number[], b: number[]) => {
  const dx = Math.max(46, Math.abs(b[0] - a[0]) * 0.46);
  return `M${a[0]} ${a[1]} C${a[0] + dx} ${a[1]}, ${b[0] - dx} ${b[1]}, ${b[0]} ${b[1]}`;
};
const vt = (a: number[], b: number[]) => {
  const dy = Math.max(40, Math.abs(b[1] - a[1]) * 0.5);
  return `M${a[0]} ${a[1]} C${a[0]} ${a[1] + dy}, ${b[0]} ${b[1] - dy}, ${b[0]} ${b[1]}`;
};

const wires = [
  { d: hz(rt(nodes[0]), lf(nodes[1])), k: 'ok' },
  { d: hz(rt(nodes[1]), lf(nodes[2])), k: 'ok' },
  { d: vt(bt(nodes[1]), tp(nodes[3])), k: 'no' },
];

const pc = (x: number, y: number) => `left:${(x / 10).toFixed(2)}%;top:${(y / 5.6).toFixed(2)}%`;
const ports = [
  { p: rt(nodes[0]), k: 'ok' }, { p: lf(nodes[1]), k: 'ok in' },
  { p: rt(nodes[1]), k: 'ok' }, { p: lf(nodes[2]), k: 'ok in' },
  { p: bt(nodes[1]), k: 'no' }, { p: tp(nodes[3]), k: 'no in' },
  { p: rt(nodes[2]), k: 'ok end' }, { p: bt(nodes[3]), k: 'no end' },
];
---

<div data-tilt="3" class="tilt browser kframe blue in relative glow-blue" style="container-type: inline-size;">
  <div class="browser-bar">
    <span class="dot bg-[#ff5f57]/80"></span><span class="dot bg-[#febc2e]/80"></span><span class="dot bg-[#28c840]/80"></span>
    <span class="ml-2 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">app.korvex.com.br/produtos/funil</span>
  </div>

  <div class="fb" role="img" aria-label="Construtor de funil da Korvex com upsell, upsell 2 e downsell ligados ao checkout">
    <aside class="fb-side">
      {side.map((g) => (
        <div class="fb-grp">
          <p class="fb-glbl">{g.g}</p>
          {g.items.map(([l, badge, on]) => (
            <span class={`fb-sitem${on ? ' on' : ''}`}>
              {l}{badge && <i class="fb-badge">{badge}</i>}
            </span>
          ))}
        </div>
      ))}
    </aside>

    <div class="fb-main">
      <div class="fb-head">
        <span class="fb-thumb">ME</span>
        <div>
          <p class="fb-hrow"><i class="fb-live">Ativo</i><b>MÉTODO ESCALA</b></p>
          <p class="fb-meta">Tipo: Digital</p>
          <p class="fb-note">* As atualizações podem levar até 1 minuto para serem aplicadas no checkout</p>
        </div>
      </div>

      <div class="fb-canvas">
        <span class="fb-expand" set:html={icon('expand')} />

        <svg class="fb-wires" viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true">
          {wires.map((w) => <path class={w.k} d={w.d} />)}
        </svg>

        {ports.map((o) => <i class={`fb-port ${o.k}`} style={pc(o.p[0], o.p[1])}></i>)}

        {nodes.map((n) => (
          <div class={`fb-node ${n.k}`} style={pc(n.x, n.y)}>
            <span class="fb-ni" set:html={icon(n.k)} />
            <span class="fb-nimg">ME</span>
            <span class="fb-txt">
              <em>#{n.id}</em>
              <b>{n.t}</b>
              <u>{n.s}</u>
            </span>
          </div>
        ))}

        <div class="fb-zoom">
          <i set:html={icon('plus')} /><i set:html={icon('minus')} /><i set:html={icon('expand')} /><i set:html={icon('lock')} />
        </div>

        <aside class="fb-acts">
          <span class="fb-act"><i set:html={icon('plus')} />Adicionar etapa<u set:html={icon('chevron')} /></span>
          <span class="fb-act"><i set:html={icon('gear')} />Configurações do funil<u set:html={icon('chevron')} /></span>
          <span class="fb-save">Salvar alterações</span>
        </aside>
      </div>
    </div>
  </div>
</div>

<style>
  .fb {
    --fb-bg: #070D17; --fb-side: #0A1220; --fb-card: #101828; --ln: rgba(255,255,255,.07);
    --mt: #F4F6FB; --mt2: #A8B0C2; --mt3: #6A7388; --ac: #2563EB; --ac2: #6FA0FF;
    --ok: #22C55E; --no: #EF4444;
    display: grid; grid-template-columns: 13.6em 1fr; aspect-ratio: 16/9; overflow: hidden;
    font-size: clamp(7px, 1.16cqw, 12.5px); font-family: var(--font-display); color: var(--mt2); background: var(--fb-bg);
    transform-style: preserve-3d;
  }

  /* navegação do produto */
  .fb-side { padding: 1.1em .85em; background: var(--fb-side); border-right: 1px solid var(--ln); overflow: hidden; }
  .fb-grp + .fb-grp { margin-top: .8em; }
  .fb-glbl { padding: 0 .5em .35em; font-size: .72em; font-weight: 600; color: var(--mt3); border-bottom: 1px solid var(--ln); }
  .fb-sitem { position: relative; display: flex; align-items: center; gap: .4em; padding: .48em .6em; margin-top: .18em; border-radius: .45em; font-size: .78em; font-weight: 500; color: var(--mt2); }
  .fb-sitem.on { background: rgba(255,255,255,.07); color: var(--mt); font-weight: 600; }
  .fb-sitem.on::before { content: ''; position: absolute; left: -.8em; top: 0; bottom: 0; width: .32em; border-radius: 0 .2em .2em 0; background: #3B82F6; }
  .fb-badge { display: grid; place-items: center; min-width: 1.5em; height: 1.5em; margin-left: auto; padding: 0 .35em; border-radius: .35em; background: rgba(255,255,255,.08); font-style: normal; font-size: .82em; font-weight: 600; color: var(--mt2); }

  .fb-main { display: flex; flex-direction: column; gap: .75em; padding: 1em 1.1em 1.1em; min-width: 0; }

  /* card do produto */
  .fb-head { display: flex; gap: .8em; padding: .8em .9em; border-radius: .7em; border: 1px solid var(--ln); background: var(--fb-card); }
  .fb-thumb { display: grid; place-items: center; width: 4em; height: 4em; border-radius: .5em; background: #fff; color: #0B1220; font-size: .95em; font-weight: 800; letter-spacing: .02em; flex: none; }
  .fb-hrow { display: flex; align-items: center; gap: .55em; }
  .fb-hrow b { font-size: 1em; font-weight: 700; letter-spacing: .02em; color: var(--mt); }
  .fb-live { padding: .2em .6em; border-radius: .35em; background: rgba(34,197,94,.16); color: #4ADE80; font-style: normal; font-size: .72em; font-weight: 600; }
  .fb-meta { margin-top: .3em; font-size: .75em; color: var(--mt2); }
  .fb-note { margin-top: .2em; font-size: .68em; color: var(--mt3); }

  /* canvas */
  .fb-canvas { position: relative; flex: 1; border-radius: .7em; border: 1px solid var(--ln); background: radial-gradient(rgba(255,255,255,.07) 1px, transparent 1.2px) 0 0 / 1.5em 1.5em, var(--fb-card); overflow: hidden; }
  .fb-expand { position: absolute; right: .8em; top: .8em; z-index: 3; display: grid; place-items: center; width: 2em; height: 2em; padding: .45em; border-radius: .45em; background: rgba(255,255,255,.07); color: var(--mt2); }
  .fb-wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .fb-wires path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-dasharray: 6 6; }
  .fb-wires .ok { stroke: var(--ok); }
  .fb-wires .no { stroke: var(--no); }

  .fb-port { position: absolute; z-index: 2; width: .78em; height: .78em; margin: -.39em 0 0 -.39em; border-radius: 999px; background: var(--fb-card); border: 1.5px solid var(--ok); }
  .fb-port.no { border-color: var(--no); }
  .fb-port.in::after { content: ''; position: absolute; left: 1em; top: 50%; width: 0; height: 0; transform: translateY(-50%);
    border-left: .55em solid var(--ok); border-top: .38em solid transparent; border-bottom: .38em solid transparent; }
  .fb-port.no.in::after { left: 50%; top: 1em; transform: translateX(-50%) rotate(90deg); border-left-color: var(--no); }

  .fb-node {
    position: absolute; z-index: 1; width: 21%; height: 14.6%;
    display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: .5em;
    padding: .45em .6em; border-radius: .6em; background: var(--fb-card); border: 1px solid var(--ln); box-shadow: 0 .7em 1.6em -.9em rgba(0,0,0,.9);
  }
  .fb-node .fb-ni { display: grid; place-items: center; width: 1.9em; height: 1.9em; padding: .42em; border-radius: 999px; flex: none; }
  .fb-node.flag .fb-ni { background: rgba(37,99,235,.2); color: var(--ac2); }
  .fb-node.thumbup .fb-ni { background: rgba(34,197,94,.18); color: #4ADE80; }
  .fb-node.thumbdown .fb-ni { background: rgba(249,115,22,.18); color: #FB923C; }
  .fb-nimg { display: grid; place-items: center; width: 2.3em; height: 2.3em; border-radius: .35em; background: #fff; color: #0B1220; font-size: .72em; font-weight: 800; }
  .fb-txt { min-width: 0; }
  .fb-txt em { display: block; font-family: var(--font-mono); font-style: normal; font-size: .64em; color: var(--mt3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-txt b { display: block; font-size: .85em; font-weight: 700; color: var(--mt); line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-txt u { display: block; font-style: italic; text-decoration: none; font-size: .7em; color: var(--mt3); }

  .fb-zoom { position: absolute; left: .9em; bottom: .9em; z-index: 3; display: flex; flex-direction: column; overflow: hidden; border-radius: .35em; box-shadow: 0 .4em 1em -.4em rgba(0,0,0,.6); }
  .fb-zoom i { display: grid; place-items: center; width: 1.9em; height: 1.7em; padding: .42em; background: #fff; color: #1B2333; }
  .fb-zoom i + i { border-top: 1px solid rgba(0,0,0,.12); }

  .fb-acts { position: absolute; right: .9em; bottom: .9em; z-index: 3; display: flex; flex-direction: column; gap: .5em; width: 14.5em; }
  .fb-act { display: grid; grid-template-columns: 1.15em 1fr .9em; align-items: center; gap: .55em; padding: .7em .85em; border-radius: .5em; border: 1px solid var(--ln); background: rgba(16,24,40,.92); font-size: .78em; font-weight: 500; color: var(--mt); }
  .fb-act i, .fb-act u { display: block; width: 100%; }
  .fb-act i { color: var(--mt2); }
  .fb-act u { color: var(--mt3); }
  .fb-save { padding: .75em 1em; border-radius: .5em; background: var(--ac); color: #fff; font-size: .82em; font-weight: 700; text-align: center; box-shadow: inset 0 1px 0 rgba(255,255,255,.2); transform: translateZ(22px); }

  @media (prefers-reduced-motion: reduce) { .fb-save { transform: none; } }

  @media (max-width: 1023px) {
    .fb { grid-template-columns: 1fr; aspect-ratio: auto; font-size: 11px; }
    .fb-side, .fb-wires, .fb-zoom, .fb-expand { display: none; }
    .fb-main { padding: .9em; gap: .7em; }
    .fb-note { display: none; }
    .fb-canvas { display: flex; flex-direction: column; gap: 1.6em; padding: 1.1em; min-height: 0; }
    /* o left/top vem de style inline, então precisa de !important para soltar o nó */
    .fb-node { position: relative; left: auto !important; top: auto !important; width: auto; height: auto; }
    .fb-port { display: none; }
    .fb-node + .fb-node::before { content: ''; position: absolute; left: 50%; top: -1.15em; width: 0; height: 0; transform: translateX(-50%) rotate(90deg);
      border-left: .6em solid var(--ok); border-top: .42em solid transparent; border-bottom: .42em solid transparent; }
    .fb-node + .fb-node.thumbdown::before { border-left-color: var(--no); }
    .fb-acts { position: static; width: auto; margin-top: auto; }
    .fb-act { display: none; }
    .fb-save { transform: none; }
  }
</style>

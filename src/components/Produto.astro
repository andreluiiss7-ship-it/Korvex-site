---
import { icon } from '../lib/icons';
import { REGISTER_URL } from '../lib/site';
import ProductShot3D from './ProductShot3D.astro';
import ProductUpsellPanel from './ProductUpsellPanel.astro';
import ProductMedPanel from './ProductMedPanel.astro';
import IconRow from './IconRow.astro';

// os sete temas reais do checkout, na ordem do painel
const themes = [
  { key: 'padrao',  name: 'Padrão',   note: 'Duas colunas, resumo ao lado' },
  { key: 'moderno', name: 'Moderno',  note: 'Escuro, produto em destaque' },
  { key: 'etapas3', name: '3 Etapas', note: 'Revisão antes de pagar' },
  { key: 'etapas2', name: '2 Etapas', note: 'Duas etapas num cartão' },
  { key: 'vitrine', name: 'Vitrine',  note: 'Produto no topo da página' },
  { key: 'foco',    name: 'Foco',     note: 'Seções numeradas' },
  { key: 'express', name: 'Express',  note: 'O mínimo: Pix na mesma tela' },
];

const chapters = [
  {
    id: 'checkout', n: '01', label: 'Checkout', tab: 'Checkout',
    h: 'Sete checkouts. Teste qual vende mais.',
    p: 'Sete temas prontos e teste A/B entre eles. O melhor fica no ar.',
    bullets: [{ icon: 'percent', label: 'Teste A/B entre checkouts' }, { icon: 'cursor', label: 'Checkout dentro do seu site' }, { icon: 'bolt', label: 'Leve no celular' }],
  },
  {
    id: 'ofertas', n: '02', label: 'Mais por venda', tab: 'Ofertas',
    h: 'A venda não acaba no primeiro Pix.',
    p: 'Oferta extra no checkout e oferta depois da compra. O comprador aceita em um clique, sem digitar nada de novo.',
    bullets: [{ icon: 'repeat', label: 'Upsell em um clique no Pix' }, { icon: 'calendar', label: 'Parcelado no Pix, de 2 a 12 vezes' }, { icon: 'undo', label: 'Recuperação de Pix não pago por e-mail' }],
  },
  {
    id: 'membros', n: '03', label: 'Área de membros', tab: 'Membros',
    h: 'Área de membros que vende de novo.',
    p: 'Cara de streaming. O aluno compra a próxima oferta lá dentro.',
    bullets: [{ icon: 'cart', label: 'Venda dentro da área' }, { icon: 'file', label: 'PDF marcado com os dados do comprador' }, { icon: 'trophy', label: 'Certificado com QR' }],
  },
  {
    id: 'protecao', n: '04', label: 'Proteção', tab: 'MED',
    h: 'MED respondido sem você abrir o painel.',
    p: 'Chegou a contestação, a defesa já está montada com o que o comprador fez: acessos, aulas assistidas e aceite dos termos.',
    bullets: [{ icon: 'shield', label: 'Defesa montada sozinha' }, { icon: 'eye', label: 'Você revisa ou deixa no automático' }, { icon: 'clock', label: 'Nenhum real travado sem motivo e data' }],
  },
];
---

<section id="produto" class="sec relative">
  <div class="section">
    <header class="reveal max-w-xl">
      <span class="chapter hidden lg:inline-flex">Produto</span>
      <h2 class="h2 mt-4">Do clique ao aluno.<br /><span class="muted">Num painel só.</span></h2>
      <p class="lead mt-4 hidden lg:block">Checkout, oferta depois da compra, área de membros e defesa de MED. Sem plugin e sem segunda ferramenta.</p>
    </header>

    <div class="pv mt-[--gap-lg]" data-pv>
      <nav class="pv-rail" aria-label="Capítulos do produto">
        {chapters.map((c, i) => (
          <a href={`#${c.id}`} class="pv-mark" aria-current={i === 0 ? 'step' : undefined}>
            <span class="pv-br">[</span><span class="pv-n">{c.n}</span><span class="pv-br">]</span>
          </a>
        ))}
        <span class="pv-prog" aria-hidden="true"><i></i></span>
      </nav>

      {chapters.map((c, i) => (
        <>
          <article id={c.id} class={`pv-chapter reveal${i === 0 ? ' on-m' : ''}`} data-chapter={i} style={`--row:${i + 1}`}>
            <span class="chapter">{c.n} · {c.label}</span>
            <h3 class="pv-h3 mt-4">{c.h}</h3>
            <p class="pv-p mt-3">{c.p}</p>
            <IconRow class="mt-5 hidden lg:grid" variant="product" items={c.bullets} />
          </article>

          {i === 0 && (
            <div class="pv-mtabs seg lg:hidden" role="group" aria-label="Partes do produto">
              {chapters.map((t, j) => (
                <button type="button" data-mpanel={j} aria-pressed={j === 0 ? 'true' : 'false'} class={`seg-tab${j === 0 ? ' active' : ''}`}>
                  <span class="ck-br">[</span><span class="ck-label">{t.tab}</span><span class="ck-br">]</span>
                </button>
              ))}
            </div>
          )}
          <div class={`pv-panel${i === 0 ? ' on-m' : ''}`} data-panel={i} data-active={i === 0 ? 'true' : 'false'} data-tilt-zone style={`--row:${i + 1}`}>
            {i === 0 && <ProductShot3D kind="checkout" />}
            {i === 1 && <ProductUpsellPanel />}
            {i === 2 && <ProductShot3D kind="membros" />}
            {i === 3 && <ProductMedPanel />}
          </div>
        </>
      ))}
    </div>
  </div>

  <!-- trilho dos sete temas: prints reais; anda de lado com a rolagem no computador, arrasta no celular -->
  <div class="trail mt-[--gap-lg]" aria-label="Os sete temas de checkout">
    <div class="trail-stage">
      <ul class="trail-track">
        {themes.map((t, i) => (
          <li class="trail-card">
            <figure>
              <div class="trail-shot">
                <img src={`/assets/app/ck-${t.key}-800.webp`} width="800" height="500" alt={`Checkout da Korvex no tema ${t.name}`} loading="lazy" decoding="async" />
              </div>
              <figcaption><b>{String(i + 1).padStart(2, '0')}</b><span>{t.name}</span><em>{t.note}</em></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="section">
    <div class="reveal mt-[--gap-md] flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href={REGISTER_URL} target="_blank" rel="noopener" data-cta="produto-register" class="btn btn-primary">
        Montar minha operação
        <span class="h-4 w-4" set:html={icon('arrow')}></span>
      </a>
      <p class="hidden text-[13px] text-[--t-3] lg:block">Sete temas reais, todos no ar hoje. Você troca sem refazer o checkout.</p>
    </div>
  </div>
</section>

<script>
  // Rolagem fixa: o painel e a marca do trilho seguem o capítulo que está na faixa central da tela
  const root = document.querySelector<HTMLElement>('[data-pv]');
  if (root) {
    const chapters = [...root.querySelectorAll<HTMLElement>('.pv-chapter')];
    const panels = [...root.querySelectorAll<HTMLElement>('.pv-panel')];
    const marks = [...root.querySelectorAll<HTMLElement>('.pv-mark')];
    const mq = matchMedia('(min-width: 1024px)');
    let io: IntersectionObserver | null = null;

    const activate = (i: number) => {
      panels.forEach((p, j) => { p.dataset.active = String(j === i); p.setAttribute('aria-hidden', String(j !== i)); });
      marks.forEach((m, j) => (j === i ? m.setAttribute('aria-current', 'step') : m.removeAttribute('aria-current')));
      root.style.setProperty('--pv-step', String(i));
    };
    const start = () => {
      io?.disconnect();
      io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.chapter)); });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      chapters.forEach((c) => io!.observe(c));
    };
    const stop = () => {
      io?.disconnect(); io = null;
      panels.forEach((p) => { p.dataset.active = 'true'; p.removeAttribute('aria-hidden'); });
    };
    const apply = () => (mq.matches ? start() : stop());
    apply();
    mq.addEventListener('change', apply);
  }

  // Celular: as abas trocam o painel e o texto visíveis
  const mtabs = document.querySelectorAll<HTMLButtonElement>('[data-mpanel]');
  mtabs.forEach((t) => t.addEventListener('click', () => {
    const i = t.dataset.mpanel;
    mtabs.forEach((x) => { const on = x === t; x.classList.toggle('active', on); x.setAttribute('aria-pressed', String(on)); });
    document.querySelectorAll<HTMLElement>('.pv-panel').forEach((p) => p.classList.toggle('on-m', p.dataset.panel === i));
    document.querySelectorAll<HTMLElement>('.pv-chapter').forEach((c) => c.classList.toggle('on-m', c.dataset.chapter === i));
  }));
</script>

<style>
  /* celular primeiro: uma coluna, painéis estáticos, trilho de capítulos oculto */
  .pv { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 1.25rem; }
  .pv-rail { display: none; }
  .pv-panel { min-width: 0; }
  @media (max-width: 1023px) {
    .pv-mtabs { order: 1; margin-left: -10px; overflow-x: auto; scrollbar-width: none; }
    .pv-mtabs::-webkit-scrollbar { display: none; }
    .pv-mtabs .seg-tab { flex: none; white-space: nowrap; padding-inline: 6px; }
    .pv-chapter { order: 2; }
    .pv-panel { order: 3; padding-bottom: 26px; }
    .pv-panel:not(.on-m), .pv-chapter:not(.on-m) { display: none; }
    .pv-chapter .chapter { display: none; }
  }

  .pv-h3 { font-family: var(--font-display); font-weight: 700; color: #fff; letter-spacing: -0.03em; line-height: 1.05; font-size: clamp(1.75rem, 2.6vw, 2.5rem); text-wrap: balance; }
  .pv-p { font-size: 16.5px; line-height: 1.55; color: var(--t-2); max-width: 46ch; text-wrap: pretty; }

  .pv-mark { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; color: var(--t-4); transition: color .3s var(--ease-out); }
  .pv-mark .pv-br { color: transparent; transition: color .3s var(--ease-out); }
  .pv-mark .pv-n { padding: 0 5px; }
  .pv-mark[aria-current="step"] { color: #fff; }
  .pv-mark[aria-current="step"] .pv-br { color: rgba(255,255,255,0.85); }
  @media (hover: hover) and (pointer: fine) { .pv-mark:hover { color: var(--t-2); } }
  /* progresso do capítulo: um traço que desce no trilho */
  .pv-prog { position: absolute; left: -1px; top: 0; bottom: 0; width: 1px; background: var(--line-1); }
  .pv-prog i { position: absolute; left: 0; top: 0; width: 1px; height: 25%; background: var(--blue-2); transform: translateY(calc(var(--pv-step, 0) * 100%)); transition: transform .6s var(--ease-snap); }

  /* computador: trilho | texto | palco fixo */
  @media (min-width: 1024px) {
    .pv {
      grid-template-columns: 48px minmax(0, 0.86fr) minmax(0, 1.14fr);
      grid-template-rows: repeat(4, auto);
      column-gap: clamp(2rem, 4vw, 4.5rem);
      row-gap: 0;
      align-items: start;
      perspective: 1400px;
    }
    .pv-rail { display: flex; flex-direction: column; gap: 4px; grid-column: 1; grid-row: 1 / 5; position: sticky; top: calc(50vh - 94px); align-self: start; }
    .pv-chapter { grid-column: 2; grid-row: var(--row); min-height: clamp(400px, 52vh, 500px); display: flex; flex-direction: column; justify-content: center; padding-block: clamp(20px, 3.5vh, 36px); margin: 0; scroll-margin-top: 96px; }
    .pv-panel {
      grid-column: 3; grid-row: 1 / 5;
      position: sticky; top: 17vh; align-self: start; margin: 0;
      opacity: 0; transform: translateZ(-110px) rotateY(9deg) translateY(14px);
      pointer-events: none; visibility: hidden;
      transition: opacity .5s var(--ease-out), transform .7s var(--ease-out), visibility 0s linear .5s;
    }
    .pv-panel[data-active="true"] {
      opacity: 1; transform: none; pointer-events: auto; visibility: visible; z-index: 2;
      transition: opacity .5s var(--ease-out) .08s, transform .72s var(--ease-snap) .08s, visibility 0s;
    }
  }
  /* as animações em ciclo dos painéis só rodam no painel em foco */
  .pv-panel:not([data-active="true"]):not(.on-m) :global(*) { animation-play-state: paused !important; }

  /* ---------- trilho dos temas ---------- */
  .trail { overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .trail::-webkit-scrollbar { display: none; }
  .trail-track { display: flex; gap: 16px; width: max-content; padding-inline: 20px; }
  .trail-card { flex: none; width: min(78vw, 400px); scroll-snap-align: center; }
  .trail-shot { border-radius: 10px; overflow: hidden; border: 1px solid var(--line-2); background: #0B121C; box-shadow: 0 24px 50px -30px rgba(0,0,0,.9); }
  .trail-shot img { display: block; width: 100%; height: auto; }
  .trail-card figcaption { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: baseline; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line-1); }
  .trail-card figcaption b { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; color: var(--t-3); }
  .trail-card figcaption span { font-family: var(--font-display); font-size: 15px; font-weight: 600; color: #fff; }
  .trail-card figcaption em { grid-column: 2; font-style: normal; font-size: 12.5px; color: var(--t-3); }
  @media (max-width: 1023px) { .trail-card figcaption em { display: none; } }

  @media (min-width: 1024px) {
    .trail { perspective: 1600px; perspective-origin: 30% 50%; padding-block: 34px 26px; }
    .trail-stage { transform: rotateY(-13deg) rotateX(3deg); transform-origin: 0 50%; }
    .trail-track { gap: 26px; padding-inline: max(32px, calc((100vw - 1216px) / 2)); }
    .trail-card { width: 420px; transition: transform .5s var(--ease-snap); }
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) { .trail-card:hover { transform: translateY(-8px); } }

  /* com timeline de rolagem: sem barra, o trilho desliza enquanto a faixa cruza a tela */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
      .trail { overflow-x: clip; overflow-y: visible; scroll-snap-type: none; }
      .trail-track { animation: trail-x linear both; animation-timeline: view(); animation-range: entry 10% exit 90%; }
    }
  }
  @keyframes trail-x { from { transform: translateX(6%); } to { transform: translateX(calc(-100% + 88vw)); } }

  @media (prefers-reduced-motion: reduce) {
    .pv-panel, .pv-mark, .pv-prog i { transition: none !important; }
    .trail-stage { transform: none; }
  }
</style>

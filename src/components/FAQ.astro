---
import { WHATSAPP_DUVIDA_URL } from '../lib/site';
import { icon } from '../lib/icons';

import { faqs } from '../lib/faq';
---

<section id="faq" class="sec relative">
  <div class="section grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
    <div class="reveal">
      <h2 class="h2">
        Perguntas diretas.<br />Respostas diretas.
      </h2>
      <p class="lead mt-4 hidden max-w-sm lg:block">
        Sobrou dúvida? Gente, não robô.
      </p>
      <a href={WHATSAPP_DUVIDA_URL} target="_blank" rel="noopener" data-cta="faq-wa" class="btn btn-ghost mt-6 !py-2.5 text-[13px]">Falar no WhatsApp</a>
    </div>

    <div class="reveal-stagger divide-y divide-white/[0.08] border-y border-white/[0.08]">
      {faqs.map((f, i) => (
        <details class="group" name="faq">
          <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between gap-4 py-3.5">
            <span class="flex items-center gap-3 font-display text-[16px] font-semibold text-white"><span class="h-[18px] w-[18px] flex-none text-[--t-3]" set:html={icon(f.icon)} />{f.q}</span>
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full border border-white/10 text-chrome-300 transition-transform duration-500 group-open:rotate-45" style="transition-timing-function:var(--ease-spring);">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            </span>
          </summary>
          <div class="pb-4 pr-10 text-[15px] leading-relaxed text-chrome-300/75">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  if (matchMedia('(min-width: 1024px)').matches) document.querySelector('#faq details')?.setAttribute('open', '');
</script>

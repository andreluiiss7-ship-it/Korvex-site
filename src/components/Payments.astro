---
import { icon } from '../lib/icons';
import { waUrl, REGISTER_URL } from '../lib/site';

const payouts = [
  { icon: 'bolt',  title: 'Pix · D0',                  desc: 'Pediu, caiu. No mesmo dia, sem reserva.', tag: '+ rápido' },
  { icon: 'card',  title: 'Cartão · D+30',             desc: 'Previsível. Sem surpresa no extrato.', tag: 'padrão' },
  { icon: 'clock', title: 'Antecipação · D+14 ou D+2', desc: 'Precisa antes? Antecipe com taxa combinada antes, não descoberta depois.', tag: 'flex' },
  { icon: 'coin',  title: 'Cripto · saque',            desc: 'Saque em criptomoeda quando fizer sentido pro seu caixa.', tag: 'novo' },
];
---

<section id="pagamentos" class="sec relative">
  <div class="section">
    <!-- header -->
    <div class="reveal grid items-end gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <span class="chapter">Taxas</span>
        <h2 class="h2 mt-4">
          6,99% + R$ 1,99.
          <span class="block muted">Travado em contrato.</span>
        </h2>
      </div>
      <p class="lead max-w-md">
        A taxa que você assina é a taxa do extrato. <strong class="text-white">Só muda com a sua assinatura</strong>, nunca por e-mail automático.
      </p>
    </div>

    <!-- price-hero + payout-list -->
    <div class="reveal mt-[--gap-md] grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-8 lg:items-stretch">
      <!-- Price hero card -->
      <div class="kframe relative overflow-hidden rounded-3xl border border-[--line-1] p-8" style="background: radial-gradient(600px 400px at 0% 0%, rgba(59,130,246,0.10), transparent 60%), linear-gradient(180deg, var(--bg-1), var(--bg-0)); box-shadow: var(--shadow-card);">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-chrome-300/60">Taxa padrão</p>
        <div class="mt-3 flex items-baseline gap-3">
          <span class="font-display text-[4.5rem] font-bold leading-none text-white sm:text-[5rem]" style="letter-spacing: -0.04em; font-feature-settings: 'tnum';" data-counter data-target="6.99" data-decimals="2" data-suffix="%">6,99%</span>
        </div>
        <p class="mt-4 text-[14px] text-chrome-300/65">+ R$ 1,99 por venda aprovada</p>
        <p class="mt-5 max-w-md text-pretty text-[15px] leading-relaxed text-chrome-200/90">
          Zero reserva de segurança. Zero taxa escondida. O que entra no checkout é o que aparece no extrato.
        </p>

        <hr class="my-5 border-t border-[--line-1]" />

        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-[14px] text-chrome-200/90">
            <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full border border-titan-500/30 bg-titan-600/15 text-titan-400">
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Zero reserva de segurança
          </li>
          <li class="flex items-center gap-3 text-[14px] text-chrome-200/90">
            <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full border border-titan-500/30 bg-titan-600/15 text-titan-400">
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            Sem setup, sem mensalidade, sem mínimo
          </li>
          <li class="flex items-center gap-3 text-[14px] text-chrome-200/90">
            <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full border border-titan-500/30 bg-titan-600/15 text-titan-400">
              <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <a href={waUrl('Olá! Faturo alto e quero a condição da Korvex por escrito pra minha operação.')} target="_blank" rel="noopener" class="underline decoration-titan-400/40 underline-offset-4 transition-colors hover:text-white">Volume alto: condição própria, por escrito</a>
          </li>
        </ul>

        <a href={REGISTER_URL} target="_blank" rel="noopener" class="btn btn-primary mt-6">
          Abrir conta na Korvex
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
      </div>

      <!-- Payout list -->
      <div class="reveal-stagger flex flex-col gap-2.5">
        {payouts.map((p) => (
          <div class="payout">
            <div class="payout-i" set:html={icon(p.icon)}></div>
            <div>
              <b>{p.title}</b>
              <span>{p.desc}</span>
            </div>
            <span class="payout-tag">{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

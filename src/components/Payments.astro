---
import { icon } from '../lib/icons';
import { waUrl, REGISTER_URL } from '../lib/site';

const payouts = [
  { icon: 'bolt',  title: 'Pix · D0',                  desc: 'Cai no mesmo dia. Sem reserva.', tag: '+ rápido', live: true },
  { icon: 'card',  title: 'Cartão · D+30',             desc: 'Previsível. Sem surpresa no extrato.', tag: 'padrão' },
  { icon: 'clock', title: 'Antecipação · D+14 ou D+2', desc: 'Taxa combinada antes, não descoberta depois.', tag: 'flex' },
  { icon: 'coin',  title: 'Cripto · saque',            desc: 'Quando fizer sentido pro seu caixa.', tag: 'novo' },
  { icon: 'pix',   title: 'API Pix · integração',      desc: 'Cobrança do seu sistema, webhook de confirmação, D0 igual.', tag: 'dev' },
];
const timeline = [
  { d: 'D0',   l: 'Pix · API Pix', w: 0 },
  { d: 'D+2',  l: 'antecipação',   w: 0.067 },
  { d: 'D+14', l: 'antecipação',   w: 0.467 },
  { d: 'D+30', l: 'cartão',        w: 1 },
];
---

<section id="pagamentos" class="sec relative">
  <div class="section">
    <!-- header -->
    <div class="reveal grid items-end gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <span class="chapter hidden lg:inline-flex">Taxas</span>
        <h2 class="h2 mt-4">
          6,99% + R$ 1,99.
          <span class="block muted">Travado em contrato.</span>
        </h2>
      </div>
      <p class="lead hidden max-w-md lg:block">
        A taxa do contrato é a taxa do extrato. <strong class="text-white">Só muda com a sua assinatura.</strong>
      </p>
    </div>

    <!-- price-hero + payout-list -->
    <div class="reveal mt-[--gap-md] grid gap-6 lg:grid-cols-[1fr_1fr] lg:gap-8 lg:items-stretch">
      <!-- Price hero card -->
      <div class="kframe relative overflow-hidden rounded-3xl border border-[--line-1] p-8" style="background: radial-gradient(600px 400px at 0% 0%, rgba(201,163,94,0.08), transparent 60%), linear-gradient(180deg, var(--bg-1), var(--bg-0)); box-shadow: var(--shadow-card);">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-chrome-300/60">Taxa padrão</p>
        <div class="mt-3 flex items-baseline gap-3">
          <span class="font-display text-[4.5rem] font-bold leading-none text-white sm:text-[5rem]" style="letter-spacing: -0.04em; font-feature-settings: 'tnum';" data-counter data-target="6.99" data-decimals="2" data-suffix="%">6,99%</span>
        </div>
        <p class="mt-4 text-[14px] text-chrome-300/65">+ R$ 1,99 por venda aprovada</p>
        <div class="zeros mt-6">
          <div class="zero"><b>0</b><span>reserva</span></div>
          <div class="zero"><b>0</b><span>setup</span></div>
          <div class="zero"><b>0</b><span>mensalidade</span></div>
        </div>

        <hr class="my-5 border-t border-[--line-1]" />

        <a href={waUrl('Olá! Faturo alto e quero a condição da Korvex por escrito pra minha operação.')} target="_blank" rel="noopener" class="irow">
          <span class="irow-i gold" set:html={icon('spark')} />
          <span class="text-[14px] text-chrome-200/90">Volume alto? <span class="text-white underline decoration-white/30 underline-offset-4">Condição por escrito</span></span>
        </a>

        <a href={REGISTER_URL} target="_blank" rel="noopener" class="btn btn-primary mt-6">
          Abrir conta na Korvex
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
      </div>

      <!-- Payout list -->
      <div class="flex flex-col gap-2.5">
        <div class="reveal tl" aria-label="Quando o dinheiro cai">
          <div class="tl-track"><i></i>{timeline.map((t) => <b style={`--x:${t.w}`}></b>)}</div>
          <div class="tl-labels">{timeline.map((t) => <span style={`--x:${t.w}`}><em>{t.d}</em>{t.l}</span>)}</div>
        </div>
        <div class="reveal-stagger flex flex-col gap-2.5">
        {payouts.map((p) => (
          <div class={`payout${p.live ? ' live' : ''}`}>
            <div class="payout-i" set:html={icon(p.icon)}></div>
            <div>
              <b>{p.title}</b>
              <span class="hidden lg:block">{p.desc}</span>
            </div>
            <span class={`payout-tag${p.live ? ' live' : ''}`}>{p.tag}</span>
          </div>
        ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tl { padding: 14px 16px 10px; border-radius: 16px; border: 1px solid var(--line-1); background: var(--bg-1); }
  .tl-track { position: relative; height: 8px; border-radius: 999px; background: var(--line-1); margin-inline: 6px; }
  .tl-track i { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(90deg, var(--accent-live), var(--line-2) 60%, var(--line-2)); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease-out); }
  .reveal.in .tl-track i { transform: scaleX(1); }
  .tl-track b { position: absolute; top: 50%; left: calc(var(--x) * 100%); width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 999px; background: var(--bg-0); border: 3px solid var(--t-4); }
  .tl-track b:first-of-type { border-color: var(--accent-live); box-shadow: 0 0 14px rgba(52,211,153,0.55); }
  .tl-labels { position: relative; height: 34px; margin-top: 10px; margin-inline: 6px; }
  .tl-labels span { position: absolute; left: calc(var(--x) * 100%); transform: translateX(-50%); display: grid; text-align: center; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--t-4); white-space: nowrap; }
  .tl-labels span:first-child { transform: none; text-align: left; }
  .tl-labels span:last-child { transform: translateX(-100%); text-align: right; }
  .tl-labels em { font-style: normal; font-weight: 700; font-size: 11px; color: var(--t-2); }
  .tl-labels span:first-child em { color: var(--accent-live); }
  @media (max-width: 640px) { .tl-labels span:nth-child(2), .tl-track b:nth-of-type(2) { display: none; } }
</style>

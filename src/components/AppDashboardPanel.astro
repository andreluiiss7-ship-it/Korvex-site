---
// Recriação fiel da tela Início do painel real da Korvex (app.korvexgateway.com).
// Dados são da persona fictícia "Método Escala", nunca de cliente real.
import { icon } from '../lib/icons';

interface Props { class?: string }
const { class: cls = '' } = Astro.props;

const nav = [
  { i: 'home',    l: 'Início', on: true },
  { i: 'cart',    l: 'Vendas',      sub: true },
  { i: 'wallet',  l: 'Financeiro',  sub: true },
  { i: 'layers',  l: 'Produtos' },
  { i: 'users',   l: 'Clientes',    sub: true },
  { i: 'link',    l: 'Parcerias',   sub: true },
  { i: 'spark',   l: 'Marketing',   sub: true },
  { i: 'chart',   l: 'Relatórios',  sub: true },
  { i: 'plug',    l: 'Integrações', sub: true },
];
const periods = ['Hoje', 'Ontem', '7 dias', 'Este mês', '30 dias', '90 dias', 'Total'];

const kpis = [
  { l: 'Faturamento líquido', v: 'R$ 47.173,62', s: 'Hoje: R$ 5.902,62', i: 'chart', id: 'liq' },
  { l: 'Vendas pagas',        v: '512',          s: '+12,4% vs. anterior', i: 'cart', id: 'pagas', up: true },
  { l: 'Ticket médio',        v: 'R$ 101,20',    s: 'bruto por venda paga', i: 'ticket' },
  { l: 'Conversão',           v: '71,8%',        s: 'dos Pix gerados', i: 'percent' },
];
const money = [
  { l: 'Disponível para saque', v: 'R$ 12.480,90', i: 'wallet',  k: 'ok', id: 'disp' },
  { l: 'A liberar',             v: 'R$ 0,00',      i: 'clock',   k: 'wait' },
  { l: 'Em contestação',        v: 'R$ 0,00',      i: 'shield',  k: 'risk' },
  { l: 'Em saque',              v: 'R$ 4.200,00',  i: 'cashout', k: 'out' },
];

// líquido por dia, soma R$ 47.173,62
const days = [
  { d: '10/11', v: 6210 }, { d: '11/11', v: 6540 }, { d: '12/11', v: 6380 }, { d: '13/11', v: 6905 },
  { d: '14/11', v: 7120 }, { d: '15/11', v: 8116, top: true }, { d: 'hoje', v: 5902.62, now: true },
];
const MAX = 9000;
const feed = [
  { t: 'há 2 min', v: '97,00' }, { t: 'há 6 min', v: '124,00' }, { t: 'há 9 min', v: '97,00' },
  { t: 'há 14 min', v: '97,00' }, { t: 'há 21 min', v: '124,00' },
];
---

<div class={`tilt relative ${cls}`} data-tilt="2">
  <div class="browser kframe blue in relative glow-blue" style="container-type: inline-size;">
  <div class="browser-bar">
    <span class="dot bg-[#ff5f57]/80"></span><span class="dot bg-[#febc2e]/80"></span><span class="dot bg-[#28c840]/80"></span>
    <span class="ml-2 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">app.korvexgateway.com</span>
    <span class="ml-3 flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-chrome-300/60">
      <span class="relative inline-flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-live-400 opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-live-400"></span>
      </span>
      Ao vivo
    </span>
  </div>

  <div class="dash" role="img" aria-label="Painel da Korvex: faturamento líquido, vendas pagas, saldo disponível para saque e as últimas vendas no Pix entrando">
    <aside class="dash-side">
      <p class="dash-logo">
        <img src="/assets/logo-white.png" alt="Korvex" width="1352" height="352" loading="lazy" decoding="async" />
        <span>Método Escala</span>
      </p>
      <nav class="dash-nav">
        {nav.map((n) => (
          <span class={`dash-item${n.on ? ' on' : ''}`}>
            <i class="dash-ic" set:html={icon(n.i)} />{n.l}
            {n.sub && <i class="dash-ch" set:html={icon('chevron')} />}
          </span>
        ))}
      </nav>
    </aside>

    <div class="dash-main">
      <div class="dash-mtop">
        <span class="dash-burger" set:html={icon('menu')} />
        <img src="/assets/logo-white.png" alt="Korvex" width="1352" height="352" loading="lazy" decoding="async" />
        <span class="dash-av">ME</span>
      </div>

      <div class="dash-bar">
        <b>Início</b>
        <span class="dash-search"><i class="dash-ic" set:html={icon('eye')} />Buscar tela ou produto…<kbd>⌘K</kbd></span>
        <span class="dash-new"><i class="dash-ic" set:html={icon('plus')} />Criar</span>
        <span class="dash-av">ME</span>
      </div>

      <div class="dash-head">
        <div>
          <b>Início</b>
          <span data-dash-date>hoje</span>
        </div>
        <p class="dash-tabs">{periods.map((p) => <span class={p === '7 dias' ? 'on' : ''}>{p}</span>)}</p>
      </div>

      <p class="dash-cap">Vendas · Últimos 7 dias</p>
      <div class="dash-strip">
        {kpis.map((k) => (
          <div class="dash-cell">
            <p><i class="dash-ic" set:html={icon(k.i)} />{k.l}</p>
            <b data-dash={k.id}>{k.v}</b>
            <em class={k.up ? 'up' : ''} data-dash-sub={k.id}>{k.s}</em>
          </div>
        ))}
      </div>

      <p class="dash-cap">Seu dinheiro · agora</p>
      <div class="dash-strip dash-money">
        {money.map((m) => (
          <div class={`dash-cell ${m.k}`}>
            <p><i class="dash-ic" set:html={icon(m.i)} />{m.l}</p>
            {m.id
              ? <b data-dash={m.id} data-counter data-target="12480.90" data-decimals="2" data-prefix="R$ ">{m.v}</b>
              : <b>{m.v}</b>}
          </div>
        ))}
      </div>

      <div class="dash-row">
        <section class="dash-card dash-chart">
          <p class="dash-h">Total líquido no período<b data-dash="liq2">R$ 47.173,62</b></p>
          <div class="dash-bars">
            {days.map((d) => (
              <span class={`${d.top ? 'top' : ''}${d.now ? ' now' : ''}`}>
                <i style={`--s:${(d.v / MAX).toFixed(3)}`}></i>
                <u>{d.d}</u>
              </span>
            ))}
          </div>
        </section>

        <section class="dash-card dash-feed">
          <p class="dash-h">Últimas vendas</p>
          <div class="dash-list" data-dash-feed>
            {feed.map((f) => (
              <p><i set:html={icon('download')} /><span><b>Método Escala</b><u>{f.t} · Pix</u></span><em>+R$ {f.v}</em></p>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
  </div>

  <span class="float3d dash-float material" style="--z:70px" aria-hidden="true">
    <i set:html={icon('check')} />
    <b>Pix aprovado</b>
    <em>R$ 97,00 · já no saldo</em>
  </span>
</div>

<script>
  // O painel não fica parado: a cada poucos segundos cai um Pix, entra na lista,
  // soma no faturamento e no saldo disponível. É o que a tela real faz.
  (() => {
    const root = document.querySelector<HTMLElement>('.dash');
    if (!root) return;
    const dateEl = root.querySelector<HTMLElement>('[data-dash-date]');
    if (dateEl) dateEl.textContent = new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long' });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const q = (k: string) => root.querySelector<HTMLElement>(`[data-dash="${k}"]`);
    const liq = q('liq'), liq2 = q('liq2'), pagas = q('pagas'), disp = q('disp');
    const today = root.querySelector<HTMLElement>('[data-dash-sub="liq"]');
    const list = root.querySelector<HTMLElement>('[data-dash-feed]');
    const nowBar = root.querySelector<HTMLElement>('.dash-bars .now i');
    if (!liq || !disp || !list) return;
    const cell = disp.closest('.dash-cell') as HTMLElement | null;
    const brl = (n: number) => 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    let vLiq = 47173.62, vHoje = 5902.62, vPagas = 512, vDisp = 12480.9, live = false;
    new IntersectionObserver((es) => { live = es[0].isIntersecting; }, { threshold: 0.2 }).observe(root);

    setInterval(() => {
      if (!live || document.hidden) return;
      // venda de R$ 97 ou R$ 97 + oferta extra de R$ 27; líquido já sem 6,99% + R$ 1,99 por produto
      const bump = Math.random() < 0.3;
      const gross = bump ? 124 : 97;
      const net = bump ? 111.35 : 88.23;
      vLiq += net; vHoje += net; vDisp += net; vPagas += 1;
      liq.textContent = brl(vLiq);
      if (liq2) liq2.textContent = brl(vLiq);
      if (pagas) pagas.textContent = String(vPagas);
      if (today) today.textContent = 'Hoje: ' + brl(vHoje);
      disp.textContent = brl(vDisp);
      if (nowBar) nowBar.style.setProperty('--s', Math.min(0.96, vHoje / 9000).toFixed(3));
      if (cell) { cell.classList.add('hit'); setTimeout(() => cell.classList.remove('hit'), 900); }

      const row = list.lastElementChild as HTMLElement | null;
      if (row) {
        row.querySelector('u')!.textContent = 'agora · Pix';
        row.querySelector('em')!.textContent = '+' + brl(gross);
        row.classList.remove('in'); list.prepend(row);
        void row.offsetWidth; row.classList.add('in');
      }
    }, 5200);
  })();
</script>

<style>
  .dash-float {
    left: -14px; bottom: -18px;
    display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center;
    padding: 10px 14px; border-radius: 14px;
  }
  .dash-float i { grid-row: 1 / 3; display: block; width: 26px; height: 26px; padding: 6px; border-radius: 8px; background: rgba(52,211,153,.16); color: #34D399; }
  .dash-float b { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #fff; line-height: 1.1; }
  .dash-float em { font-family: var(--font-mono); font-style: normal; font-size: 10px; letter-spacing: .04em; color: var(--t-2); }
  @media (max-width: 1023px) { .dash-float { left: auto; right: 8px; bottom: -14px; } }

  .dash {
    --d-bg: #0B121C; --d-card: #101925; --d-side: #0A1019; --ln: rgba(255,255,255,.075);
    --mt: #EEF2F8; --mt2: #A3AEC2; --mt3: #6F7B90; --ac: #5C83AB; --ac2: #8FB0D3; --ok: #4ADE80;
    display: grid; grid-template-columns: 12.6em 1fr; background: var(--d-bg); overflow: hidden;
    font-family: var(--font-display); font-size: clamp(9px, 1.16cqw, 12.5px); color: var(--mt2);
  }
  .dash-ic { display: block; width: 1.3em; height: 1.3em; flex: none; color: currentColor; }
  .dash-ch { width: .75em; height: .75em; color: var(--mt3); }

  /* barra lateral */
  .dash-side { display: flex; flex-direction: column; gap: 1em; padding: 1.1em .8em; background: var(--d-side); border-right: 1px solid var(--ln); }
  .dash-logo { padding: 0 .4em; }
  .dash-logo img { display: block; width: 6.6em; height: auto; }
  .dash-logo span { display: block; margin-top: .45em; font-size: .68em; letter-spacing: .06em; text-transform: uppercase; color: var(--mt3); }
  .dash-nav { display: flex; flex-direction: column; gap: .1em; }
  .dash-item { display: grid; grid-template-columns: 1.3em 1fr auto; align-items: center; gap: .65em; padding: .55em .6em; border-radius: .45em; font-size: .86em; font-weight: 500; }
  .dash-item.on { background: rgba(92,131,171,.2); color: var(--mt); font-weight: 600; }

  /* área principal */
  .dash-main { display: flex; flex-direction: column; min-width: 0; }
  .dash-mtop { display: none; }
  .dash-bar { display: flex; align-items: center; gap: .7em; padding: .75em 1.3em; border-bottom: 1px solid var(--ln); font-size: .82em; }
  .dash-bar > b { margin-right: auto; font-weight: 600; color: var(--mt); }
  .dash-search { display: inline-flex; align-items: center; gap: .5em; width: 17em; padding: .42em .7em; border-radius: .45em; border: 1px solid rgba(255,255,255,.14); color: var(--mt3); white-space: nowrap; }
  .dash-search kbd { margin-left: auto; padding: .05em .4em; border-radius: .3em; border: 1px solid var(--ln); font-family: var(--font-mono); font-size: .82em; color: var(--mt3); }
  .dash-new { display: inline-flex; align-items: center; gap: .35em; padding: .42em .75em; border-radius: .45em; border: 1px solid var(--ln); background: rgba(255,255,255,.03); font-weight: 600; color: var(--mt); }
  .dash-av { display: grid; place-items: center; width: 2.1em; height: 2.1em; border-radius: 999px; background: rgba(92,131,171,.28); color: var(--ac2); font-size: .82em; font-weight: 700; }

  .dash-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1em; padding: 1.15em 1.3em .2em; }
  .dash-head b { display: block; font-size: 1.45em; font-weight: 700; letter-spacing: -.02em; color: var(--mt); line-height: 1.1; }
  .dash-head div span { display: block; margin-top: .25em; font-size: .78em; color: var(--mt3); }
  .dash-tabs { display: flex; border: 1px solid var(--ln); border-radius: .5em; overflow: hidden; font-size: .76em; font-weight: 500; white-space: nowrap; }
  .dash-tabs span { padding: .5em .8em; }
  .dash-tabs span + span { border-left: 1px solid var(--ln); }
  .dash-tabs .on { background: rgba(255,255,255,.07); color: var(--mt); font-weight: 600; }

  .dash-cap { padding: 1.1em 1.3em .5em; font-size: .78em; color: var(--mt3); }
  .dash-strip { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 1.3em; border: 1px solid var(--ln); border-radius: .6em; background: var(--d-card); }
  .dash-cell { padding: .85em 1em .9em; min-width: 0; transition: background-color .45s var(--ease-out); }
  .dash-cell + .dash-cell { border-left: 1px solid var(--ln); }
  .dash-cell p { display: flex; align-items: center; gap: .55em; font-size: .76em; color: var(--mt2); white-space: nowrap; }
  .dash-cell p .dash-ic { width: 1.9em; height: 1.9em; padding: .4em; border-radius: .4em; background: rgba(255,255,255,.06); }
  .dash-cell b { display: block; margin-top: .55em; font-size: 1.32em; font-weight: 700; letter-spacing: -.02em; color: var(--mt); font-variant-numeric: tabular-nums; white-space: nowrap; transition: color .45s var(--ease-out); }
  .dash-cell em { display: block; margin-top: .3em; font-style: normal; font-size: .7em; color: var(--mt3); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dash-cell em.up { color: var(--ok); }
  /* cor com função: verde entra, âmbar espera, vermelho é risco */
  .dash-money .ok p .dash-ic   { background: rgba(74,222,128,.14); color: var(--ok); }
  .dash-money .wait p .dash-ic { background: rgba(245,158,11,.14); color: #FBBF24; }
  .dash-money .risk p .dash-ic { background: rgba(248,113,113,.14); color: #F87171; }
  .dash-money .out p .dash-ic  { background: rgba(92,131,171,.22); color: var(--ac2); }
  .dash-cell.hit { background: rgba(74,222,128,.09); }
  .dash-cell.hit b { color: #86EFAC; }

  .dash-row { display: grid; grid-template-columns: 1.35fr 1fr; gap: .8em; padding: 1em 1.3em 1.3em; }
  .dash-card { border: 1px solid var(--ln); border-radius: .6em; background: var(--d-card); min-width: 0; }
  .dash-h { display: flex; align-items: baseline; justify-content: space-between; gap: 1em; padding: .8em 1em; border-bottom: 1px solid var(--ln); font-size: .82em; font-weight: 600; color: var(--mt); }
  .dash-h b { font-size: 1.15em; font-weight: 700; font-variant-numeric: tabular-nums; }

  .dash-chart { display: flex; flex-direction: column; }
  .dash-bars { flex: 1; display: grid; grid-template-columns: repeat(7, 1fr); gap: 1.1em; align-items: end; min-height: 9.2em; padding: 1em 1.2em .7em; }
  .dash-bars span { display: grid; grid-template-rows: 1fr auto; justify-items: center; height: 100%; gap: .45em; }
  .dash-bars i { display: block; width: 100%; max-width: 2em; height: 100%; border-radius: .2em .2em 0 0; background: #6F8098; transform-origin: bottom; transform: scaleY(var(--s)); animation: dash-grow 1s var(--ease-out) both; transition: transform .6s var(--ease-out); }
  .dash-bars .top i { background: #A9C0DA; }
  .dash-bars .now i { background: var(--ac); }
  .dash-bars u { text-decoration: none; font-family: var(--font-mono); font-size: .62em; color: var(--mt3); }
  .dash-bars span:nth-child(2) i { animation-delay: .06s; } .dash-bars span:nth-child(3) i { animation-delay: .12s; }
  .dash-bars span:nth-child(4) i { animation-delay: .18s; } .dash-bars span:nth-child(5) i { animation-delay: .24s; }
  .dash-bars span:nth-child(6) i { animation-delay: .3s; }  .dash-bars span:nth-child(7) i { animation-delay: .36s; }
  @keyframes dash-grow { from { transform: scaleY(0); } to { transform: scaleY(var(--s)); } }

  .dash-list { overflow: hidden; }
  .dash-list p { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .7em; padding: .55em 1em; font-size: .82em; }
  .dash-list p + p { border-top: 1px solid var(--ln); }
  .dash-list p > i { display: block; width: 1.7em; height: 1.7em; padding: .38em; border-radius: 999px; background: rgba(74,222,128,.13); color: var(--ok); }
  .dash-list b { display: block; font-weight: 600; color: var(--mt); line-height: 1.2; }
  .dash-list u { display: block; text-decoration: none; font-size: .82em; color: var(--mt3); }
  .dash-list em { font-style: normal; font-weight: 600; color: var(--ok); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dash-list p.in { animation: dash-row .55s var(--ease-snap) both; }
  @keyframes dash-row { from { opacity: 0; transform: translateY(-70%); background: rgba(74,222,128,.12); } to { opacity: 1; transform: none; background: transparent; } }

  @media (prefers-reduced-motion: reduce) { .dash-bars i { animation: none; } }

  @media (max-width: 1023px) {
    .dash { grid-template-columns: 1fr; font-size: 12px; }
    .dash-side, .dash-bar, .dash-tabs, .dash-chart { display: none; }
    .dash-mtop { display: flex; align-items: center; gap: .8em; padding: .85em 1em; border-bottom: 1px solid var(--ln); background: var(--d-side); }
    .dash-burger { display: block; width: 1.5em; height: 1.5em; color: var(--mt2); }
    .dash-mtop img { width: 6.2em; height: auto; }
    .dash-mtop .dash-av { margin-left: auto; }
    .dash-head { padding: 1em 1em 0; }
    .dash-cap { padding: .9em 1em .45em; }
    .dash-strip { grid-template-columns: 1fr 1fr; margin: 0 1em; }
    /* no celular ficam só as duas células que contam a história: quanto vendeu e quanto já é seu */
    .dash-cell:nth-child(n+3) { display: none; }
    .dash-cell b { font-size: 1.18em; }
    .dash-row { grid-template-columns: 1fr; padding: .9em 1em 1.1em; }
    .dash-list p:nth-child(n+4) { display: none; }
  }
</style>

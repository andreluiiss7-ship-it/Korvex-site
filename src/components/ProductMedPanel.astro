---
// Capítulo "Proteção": a defesa de MED que se monta com o histórico do comprador.
// Painel ilustrativo no visual do app; pedido, datas e números são fictícios.
import { icon } from '../lib/icons';

const proofs = [
  { i: 'eye',      t: 'Acessou a área de membros', v: '14 vezes' },
  { i: 'play',     t: 'Assistiu às aulas',         v: '9 de 12' },
  { i: 'file',     t: 'Aceitou os termos',         v: '02/11 · 21:14' },
  { i: 'download', t: 'Baixou os materiais',       v: '2 arquivos' },
  { i: 'link',     t: 'Comprovante de entrega',    v: 'anexado' },
];
---

<div class="tilt med" data-tilt="3">
  <div class="browser kframe blue in glow-blue" style="container-type: inline-size;">
    <div class="browser-bar">
      <span class="dot bg-[#ff5f57]/80"></span><span class="dot bg-[#febc2e]/80"></span><span class="dot bg-[#28c840]/80"></span>
      <span class="ml-2 rounded-md bg-white/5 px-2.5 py-1 text-[11px] text-chrome-300/70">app.korvexgateway.com/contestacoes</span>
    </div>

    <div class="med-pg" role="img" aria-label="Contestação de Pix recebida: a defesa é montada sozinha com acessos, aulas assistidas, aceite dos termos e materiais baixados">
      <div class="med-head">
        <div>
          <p class="med-cap">Contestação · MED</p>
          <p class="med-title">Pedido 48213 · R$ 97,00</p>
          <p class="med-sub">Método Escala · Pix · comprador alega não reconhecer a compra</p>
        </div>
        <span class="med-state"><i></i><b class="s1">Montando defesa</b><b class="s2">Defesa pronta</b></span>
      </div>

      <ul class="med-list">
        {proofs.map((p, i) => (
          <li style={`--i:${i}`}>
            <i set:html={icon(p.i)} />
            <span>{p.t}</span>
            <b>{p.v}</b>
            <u set:html={icon('check')} />
          </li>
        ))}
      </ul>

      <div class="med-foot">
        <p><span>Modo da defesa</span><b>Automático</b></p>
        <p><span>Valor separado</span><b>R$ 97,00</b></p>
        <p><span>Resto do saldo</span><b class="ok">livre</b></p>
      </div>
    </div>
  </div>

  <span class="float3d med-float material" style="--z:76px" aria-hidden="true">
    <i set:html={icon('shield')} />
    <b>Defesa enviada</b>
    <em>sem você abrir o painel</em>
  </span>
</div>

<style>
  .med-pg { --d-bg: #0B121C; --d-card: #101925; --ln: rgba(255,255,255,.075); --mt: #EEF2F8; --mt2: #A3AEC2; --mt3: #6F7B90; --ok: #4ADE80;
    background: var(--d-bg); color: var(--mt2); padding: 1.5em 1.6em 1.6em; font-family: var(--font-display); font-size: clamp(10px, 1.9cqw, 13.5px); }
  .med-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1em; }
  .med-cap { font-family: var(--font-mono); font-size: .72em; letter-spacing: .16em; text-transform: uppercase; color: var(--mt3); }
  .med-title { margin-top: .4em; font-size: 1.5em; font-weight: 700; letter-spacing: -.025em; color: var(--mt); font-variant-numeric: tabular-nums; }
  .med-sub { margin-top: .3em; font-size: .84em; color: var(--mt3); }
  .med-state { display: inline-grid; grid-template-columns: auto auto; align-items: center; column-gap: .5em; height: 2.2em; padding: 0 .8em; border-radius: .45em; border: 1px solid rgba(74,222,128,.3); background: rgba(74,222,128,.08); font-size: .8em; font-weight: 600; color: var(--ok); white-space: nowrap; }
  .med-state i { display: block; width: .5em; height: .5em; border-radius: 999px; background: var(--ok); }
  .med-state b { grid-area: 1 / 2; }
  .med-state .s1 { color: #FBBF24; opacity: 0; }

  .med-list { margin-top: 1.2em; border: 1px solid var(--ln); border-radius: .6em; background: var(--d-card); }
  .med-list li { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: .8em; padding: .78em 1em; font-size: .92em; }
  .med-list li + li { border-top: 1px solid var(--ln); }
  .med-list li > i { display: block; width: 1.9em; height: 1.9em; padding: .42em; border-radius: .4em; background: rgba(255,255,255,.06); color: var(--mt2); }
  .med-list span { color: var(--mt); }
  .med-list b { font-family: var(--font-mono); font-size: .86em; font-weight: 500; color: var(--mt2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .med-list u { display: block; width: 1.2em; height: 1.2em; color: var(--ok); text-decoration: none; }

  .med-foot { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 1em; border: 1px solid var(--ln); border-radius: .6em; }
  .med-foot p { padding: .8em 1em; }
  .med-foot p + p { border-left: 1px solid var(--ln); }
  .med-foot span { display: block; font-size: .74em; color: var(--mt3); }
  .med-foot b { display: block; margin-top: .3em; font-size: 1.05em; font-weight: 700; color: var(--mt); font-variant-numeric: tabular-nums; }
  .med-foot b.ok { color: var(--ok); }

  /* o dossiê se monta linha a linha quando o painel entra em foco; parado, fica completo */
  @media (prefers-reduced-motion: no-preference) {
    :global(.pv-panel[data-active="true"]) .med-list li,
    :global(.pv-panel.on-m) .med-list li { animation: med-in .5s var(--ease-snap) both; animation-delay: calc(.35s + var(--i) * .32s); }
    :global(.pv-panel[data-active="true"]) .med-list u,
    :global(.pv-panel.on-m) .med-list u { animation: med-ok .35s var(--ease-out) both; animation-delay: calc(.6s + var(--i) * .32s); }
    :global(.pv-panel[data-active="true"]) .med-state .s1,
    :global(.pv-panel.on-m) .med-state .s1 { animation: med-s1 2.4s var(--ease-out) both; }
    :global(.pv-panel[data-active="true"]) .med-state .s2,
    :global(.pv-panel.on-m) .med-state .s2 { animation: med-s2 2.4s var(--ease-out) both; }
    :global(.pv-panel[data-active="true"]) .med-state,
    :global(.pv-panel.on-m) .med-state { animation: med-chip 2.4s var(--ease-out) both; }
  }
  @keyframes med-in { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
  @keyframes med-ok { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  @keyframes med-s1 { 0%, 78% { opacity: 1; } 86%, 100% { opacity: 0; } }
  @keyframes med-s2 { 0%, 80% { opacity: 0; } 90%, 100% { opacity: 1; } }
  @keyframes med-chip { 0%, 78% { border-color: rgba(251,191,36,.3); background: rgba(251,191,36,.08); } 90%, 100% { border-color: rgba(74,222,128,.3); background: rgba(74,222,128,.08); } }

  .med-float { left: -16px; bottom: -18px; display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center; padding: 10px 14px; border-radius: 14px; }
  .med-float i { grid-row: 1 / 3; display: block; width: 26px; height: 26px; padding: 6px; border-radius: 8px; background: rgba(52,211,153,.16); color: #34D399; }
  .med-float b { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #fff; line-height: 1.1; }
  .med-float em { font-family: var(--font-mono); font-style: normal; font-size: 10px; letter-spacing: .04em; color: var(--t-2); }
  @media (max-width: 1023px) {
    .med-pg { font-size: 11.5px; padding: 1.2em 1.1em 1.3em; }
    .med-sub { display: none; }
    .med-float { left: auto; right: 8px; bottom: -16px; }
  }
</style>

---
import { icon } from '../lib/icons';
import { REGISTER_URL } from '../lib/site';
import IconRow from './IconRow.astro';
import Mosaic from './Mosaic.astro';

const tiers = [
  { variant: 'steel', amount: 'R$ 10.000',    name: 'Pulseira', lvl: 'Tier 01', img: '/assets/pulseira-10k.png', bracelet: true  },
  { variant: 'blue',  amount: 'R$ 100.000',   name: 'Placa',      lvl: 'Tier 02', img: '/assets/placa-100k.jpg',    bracelet: false },
  { variant: 'silver', amount: 'R$ 500.000',  name: 'Placa',      lvl: 'Tier 03', img: '/assets/placa-500k.jpg',    bracelet: false },
];
---

<section id="premiacoes" class="sec relative overflow-hidden">
  <!-- ambient gold + soft top spotlight -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0" style="background: radial-gradient(800px 500px at 50% 0%, rgba(201,163,94,0.12), transparent 60%), linear-gradient(180deg, var(--bg-0), #070B12 50%, var(--bg-0));"></div>
    <Mosaic tiles={420} seed={5} accent="gold" />
  </div>

  <div class="section">
    <!-- HEADER -->
    <div class="reveal mx-auto max-w-3xl text-center">
      <span class="kicker gold !hidden justify-center lg:!inline-flex">Reconhecimento</span>
      <h2 class="h2 mt-4">
        Faturamento alto
        <span class="block font-editorial italic font-normal" style="font-size:1.18em">
          <span class="text-gold-gradient">vira metal na parede.</span>
        </span>
      </h2>
      <p class="lead mx-auto mt-4 hidden lg:block">
        No milhão, <strong class="text-white">prêmio em dinheiro e imersão presencial</strong> com o time.
      </p>
    </div>

    <div class="reveal ladder mx-auto mt-[--gap-md] max-w-4xl">
      {['10K', '100K', '500K', '1MM'].map((m, i) => (
        <span class={`ladder-s${i === 3 ? ' gold' : ''}`}><i></i><span>{m}</span></span>
      ))}
    </div>

    <!-- TIER GRID — 3 cards compactos no mobile, 1MM é o finale abaixo -->
    <div class="reveal-stagger mx-auto mt-4 grid max-w-4xl grid-cols-3 gap-2 sm:gap-3 lg:gap-4">
      {tiers.map((t, i) => (
        <div class={`tier tier-compact ${t.variant}`} data-tilt="10" data-tilt-zone>
          <div class={`tier-img${t.bracelet ? ' bracelet' : ''}`}>
            <img src={t.img} alt={t.name} loading="lazy" decoding="async" />
          </div>
          <div class="tier-body">
            <div class="tier-lvl">{t.lvl}</div>
            <div class="tier-amount">{t.amount}</div>
            <div class="tier-name">{t.name}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- MILIONARIO STAGE — cinematic -->
    <div class="reveal mil-stage kframe gold mt-[--gap-md]">
      <div class="mil-img">
        <img src="/assets/placa-1mm.jpg" alt="Placa R$1.000.000" loading="lazy" decoding="async" />        <!-- top spotlight -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-1/2" style="background: radial-gradient(circle at 50% 0%, rgba(245,217,139,0.32), transparent 65%);"></div>
      </div>

      <div class="relative p-7 sm:p-10">
        <span class="inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-[10.5px] font-bold uppercase font-mono" style="letter-spacing:0.22em;color:var(--gold-2);background:var(--gold-tint);border:1px solid rgba(201,163,94,0.25);">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[--gold-1]"></span>
          O marco do milhão
        </span>

        <h3 class="mt-4 leading-[0.95]">
          <span class="font-editorial italic block text-5xl sm:text-7xl text-gold-gradient" data-counter data-target="1000000" data-prefix="R$ ">R$ 1.000.000</span>
          <span class="mt-2 block h-display text-2xl sm:text-3xl text-white">em vendas.</span>
        </h3>

        <IconRow class="mt-5" variant="gold" items={[{ icon: 'coin', label: 'Prêmio em dinheiro' }, { icon: 'users', label: 'Imersão presencial' }]} />

        <a href={REGISTER_URL} target="_blank" rel="noopener"
           class="btn mt-6 inline-flex"
           style="background:linear-gradient(180deg,#E0BD79,#B68C3F);color:#1A1306;box-shadow:0 1px 0 rgba(255,255,255,0.35) inset, 0 14px 30px -10px rgba(201,163,94,0.5);">
          Quero a placa do milhão
          <span class="h-4 w-4" set:html={icon('arrow')}></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ladder { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .ladder-s { display: grid; gap: 8px; text-align: center; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; color: var(--t-3); }
  .ladder-s i { display: block; height: 6px; border-radius: 999px; background: var(--line-2); transform: scaleX(0); transform-origin: left; transition: transform .9s var(--ease-out); }
  .ladder-s:nth-child(2) i { transition-delay: .15s; } .ladder-s:nth-child(3) i { transition-delay: .3s; } .ladder-s:nth-child(4) i { transition-delay: .45s; }
  .reveal.in .ladder-s i { transform: scaleX(1); }
  .ladder-s.gold { color: var(--gold-2); }
  .ladder-s.gold i { background: linear-gradient(90deg, var(--gold-1), var(--gold-2)); }
  @media (prefers-reduced-motion: reduce) { .ladder-s i { transform: none; transition: none; } }
</style>

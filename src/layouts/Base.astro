---
// Self-hosted fonts (latin subset only, sem Google Fonts CSS)
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/inter-tight/latin-700.css';
import '@fontsource/inter-tight/latin-800.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-600.css';
import interTight700 from '@fontsource/inter-tight/files/inter-tight-latin-700-normal.woff2?url';
import instrumentItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

import '../styles/global.css';
import { SITE_URL, META_PIXEL_ID } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonld?: object[];
}

const {
  title = 'Korvex · O gateway que paga no dia | 6,99% + R$ 1,99, Pix D0',
  description = 'Gateway pra infoprodutores: Pix D0, zero reserva de segurança, taxa 6,99% + R$ 1,99 travada em contrato, gerente humano em 1h, API Pix e saque em cripto.',
  noindex = false,
  jsonld = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = `${SITE_URL}/assets/og-image.jpg`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050B14" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Resource hints -->
    <link rel="dns-prefetch" href="https://wa.me" />
    <link rel="preconnect" href="https://app.korvex.com.br" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interTight700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentItalic} crossorigin />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Korvex" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {META_PIXEL_ID && (
      <Fragment>
        <script is:inline define:vars={{ META_PIXEL_ID }}>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', META_PIXEL_ID); fbq('track', 'PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} alt="" /></noscript>
      </Fragment>
    )}
  </head>
  <body>
    <!-- Scroll progress bar (top) -->
    <div id="scroll-progress" class="pointer-events-none fixed left-0 top-0 z-[60] h-[2px] w-full origin-left scale-x-0 bg-titan-400/80" style="will-change:transform"></div>

    <slot />
    <script src="../scripts/track.ts"></script>

    <!-- Reveal on scroll (with stagger) -->
    <script>
      // Declared up front so they can be used by every block below (avoid TDZ)
      const fine = window.matchMedia('(pointer:fine)').matches;
      const reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
      );
      const mount = () => {
        // auto-stagger siblings inside the same parent (.reveal-stagger)
        document.querySelectorAll<HTMLElement>('.reveal-stagger').forEach((parent) => {
          Array.from(parent.children).forEach((child, i) => {
            (child as HTMLElement).classList.add('reveal');
            (child as HTMLElement).style.transitionDelay = `${i * 55}ms`;
          });
        });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      };
      if (document.readyState !== 'loading') mount();
      else document.addEventListener('DOMContentLoaded', mount);

      // ---- Scroll progress bar ----
      // Com animation-timeline: scroll() o CSS cuida sozinho (sem listener, sem jank).
      const bar = document.getElementById('scroll-progress');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // sob reduced-motion o kill-switch global apaga a animação CSS, então o JS assume
      const cssTimeline = CSS.supports('animation-timeline: scroll()') && !reducedMotion;
      if (bar && !cssTimeline) {
        let barRaf = 0;
        const onScrollProgress = () => {
          barRaf = 0;
          const h = document.documentElement;
          const scrolled = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
          bar.style.transform = `scaleX(${scrolled})`;
        };
        window.addEventListener('scroll', () => { if (!barRaf) barRaf = requestAnimationFrame(onScrollProgress); }, { passive: true });
        onScrollProgress();
      }

      // ---- Parallax ([data-parallax="0.2"] = moves at 20% of scroll) — desktop only ----
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      // matchMedia em vez de innerWidth: redimensionar a janela passa a ligar/desligar
      const wideEnough = matchMedia('(min-width: 1024px)');
      if (parallaxEls.length && !reduced && wideEnough.matches) {
        let ticking = false;
        const onScrollParallax = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            parallaxEls.forEach((el) => {
              const speed = parseFloat(el.dataset.parallax || '0.15');
              const rect = el.getBoundingClientRect();
              const center = rect.top + rect.height / 2 - window.innerHeight / 2;
              el.style.transform = `translate3d(0, ${center * -speed}px, 0)`;
            });
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScrollParallax, { passive: true });
        onScrollParallax();
      }


      // ---- Safety fallback: nada pode ficar invisível para sempre.
      //      Sem IO, revela tudo. Com IO, revela só o que já está na tela ou acima dela,
      //      para não queimar a animação de entrada das seções de baixo.
      const revealSafety = () => {
        const noIO = !('IntersectionObserver' in window);
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          if (el.classList.contains('in')) return;
          if (noIO || el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
        });
      };
      window.setTimeout(revealSafety, 2500);
      window.addEventListener('load', revealSafety);

      // Count-up for [data-count] AND [data-counter]
      const formatCount = (target: number, dec: number) => {
        // For values >= 1,000,000 — show as "M+" formatted (e.g. 129000000 -> "129")
        // The component decides format with prefix/suffix
        return target.toLocaleString('pt-BR', {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec,
        });
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const animateCounter = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.target || el.dataset.count || '0');
        if (reduce) { el.textContent = (el.dataset.prefix || '') + formatCount(target, parseInt(el.dataset.decimals || '0')) + (el.dataset.suffix || ''); return; }
        const dec = parseInt(el.dataset.decimals || '0');
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const dur = 1800;
        let start = 0;
        const step = (now: number) => {
          if (!start) start = now;
          const p = Math.max(0, Math.min((now - start) / dur, 1));
          const eased = 1 - Math.pow(1 - p, 3);
          const val = Math.max(0, target * eased);
          el.textContent = prefix + formatCount(val, dec) + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            animateCounter(e.target as HTMLElement);
            cio.unobserve(e.target);
          });
        },
        { threshold: 0.4 }
      );
      document.querySelectorAll<HTMLElement>('[data-count],[data-counter]').forEach((el) => cio.observe(el));

      // ---- 3D tilt (elements with .tilt[data-tilt]) ----
      if (fine) {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          const max = parseFloat(el.dataset.tilt || '6');
          const parent = (el.closest('[data-tilt-zone]') as HTMLElement) || el;
          let raf = 0;
          parent.addEventListener('pointermove', (e) => {
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              const r = parent.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width - 0.5;
              const py = (e.clientY - r.top) / r.height - 0.5;
              el.style.setProperty('--rx', `${px * max}deg`);
              el.style.setProperty('--ry', `${-py * max}deg`);
              el.style.setProperty('--mx', `${(px + 0.5) * 100}%`);
              el.style.setProperty('--my', `${(py + 0.5) * 100}%`);
              // sem unidade: alimenta o offset da sombra e o brilho da quina em calc()
              el.style.setProperty('--sx', `${px * 2}`);
              el.style.setProperty('--sy', `${py * 2}`);
            });
          });
          parent.addEventListener('pointerleave', () => {
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
            el.style.setProperty('--mx', '50%');
            el.style.setProperty('--my', '50%');
            el.style.setProperty('--sx', '0');
            el.style.setProperty('--sy', '0');
          });
        });
      }
    </script>
  </body>
</html>
